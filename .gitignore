.DS_Store
*.bak
*.bak.*
*.orig
*.retired-*
__pycache__/
*.pyc
.venv/
node_modules/
# vendor/ caches are generated per instance and never belong in the canonical repo
vendor/

# df-app-walkthrough installs its toolchain and writes its media beside the skill.
# All of it is regenerable and none of it belongs in the canonical repo.
skills/df-app-walkthrough/.voices/
skills/df-app-walkthrough/package-lock.json
.walkthrough/

# The real landmark list. It IS the list of nouns that must not be published, so
# committing it would publish exactly what the gate exists to protect. Only the
# example file with placeholder patterns is tracked.
boot-kit/scripts/landmarks.conf

# The requirement list for gate-reqtest.sh. It holds a REAL specimen of every landmark
# class, so committing it would publish exactly what the gate exists to keep out — the
# same reason landmarks.conf is ignored. Only the placeholder example is tracked.
boot-kit/scripts/gate-requirements.conf

# The substrate leak denylist holds the SOURCE PROJECT real identifiers - same rule as
# landmarks.conf: the real list stays local, the committed script explains the shape.
skills/df-context-store/substrate-template/substrate-denylist.conf

# Estate-PRIVATE product names for the Tier-1 genericity gate. The shipped
# tier1-generic.conf carries public third-party products only; in-house service names are
# themselves landmarks, and the first draft of that file was rejected by publish-gate P1/P3
# for carrying three of them. Same rule again: the real list stays local.
boot-kit/scripts/tier1-generic.local.conf

# df-ui-verify writes LIVE CREDENTIALS beside the skill, and its SKILL.md already tells the
# reader they are gitignored — three times, calling them landmarks and a credential. They
# were not. `.env.local` carries CLERK_SECRET_KEY plus the frontend-API slug, user id and
# origin; `.run/` carries session.jwt and storageState.json, which are live session
# credentials. This repo is PUBLIC, so in any checkout that had run the skill a `git add -A`
# would have committed them, and `git status` would not have shown them coming.
#
# Nothing ever was committed — `git log --all` over both paths is empty. This closes a trap,
# it does not clean up a breach, and no rotation is indicated.
#
# ⚠️ A doc saying a path is ignored does not ignore it. If a skill writes a secret, the
# ignore rule belongs HERE, in the same change as the skill.
.env.local
**/.env.local
**/.run/
