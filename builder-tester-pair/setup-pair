    s["log"].parent.mkdir(parents=True, exist_ok=True)
    with open(s["log"], "a") as fh:
        fh.write(json.dumps({"ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                             "by": pairconf.role(cfg), "event": "init", "pins": pins}) + "\n")
    print("\nNext:")
