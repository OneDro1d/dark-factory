PLACE = re.compile(r"\$\{((?:json:)?[A-Za-z0-9_.]+)\}")


def render_text(text, cfg, der, strict=True):
    missing = []

    def sub(m):
        k = m.group(1)
        if k.startswith("json:"):
            k = k[5:]
        v = der.get(k[8:]) if k.startswith("derived.") else pairrules.get(cfg, k)
        if v is None or v == "":
            missing.append(k)
            return "" if v is None else v
        return json.dumps(v) if isinstance(v, (dict, list)) else str(v)
    out = PLACE.sub(sub, text)
    return out, missing


EMPTY = []  # settings a rendered rule referenced while they were empty (reported by `render`)


def json_safe_render(text, cfg, der):
    """Render a JSON template: string values are substituted inside JSON strings safely (escaped)."""
    data = json.loads(text)

    def walk(x):
        if isinstance(x, str):
            whole = PLACE.fullmatch(x)
            if whole:  # a value that is exactly one placeholder keeps its type (a list stays a list)
                k = whole.group(1)
                if k.startswith("json:"):
                    k = k[5:]
                v = der.get(k[8:]) if k.startswith("derived.") else pairrules.get(cfg, k)
                if (v is None or v == "") and not k.startswith("derived."):
                    EMPTY.append(k)
                if isinstance(v, str) and v[:1] in "[{":
                    try:
                        return json.loads(v)
                    except ValueError:
                        return v
                return v if v is not None else ""
            out, miss = render_text(x, cfg, der)
            EMPTY.extend(m for m in miss if not m.startswith("derived."))
            return out
        if isinstance(x, list):
            return [walk(i) for i in x]
        if isinstance(x, dict):
            return {k: walk(v) for k, v in x.items()}
        return x
    return walk(data)


def backup(p):
    if p.exists():
        shutil.copy2(p, p.with_name(p.name + ".bak-" + datetime.datetime.now().strftime("%Y%m%d%H%M%S")))


def seed_watermarks(sources):
    state = HOME / ".claude" / "channel-listener" / "state"
    state.mkdir(parents=True, exist_ok=True)
    now = time.time()
    iso = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    n = 0
    for s in sources:
        f = state / f"{s['key']}.json"
        if f.exists():
            continue
        last = f"{now:.6f}" if s.get("kind") == "slack" else iso
        f.write_text(json.dumps({"kind": s.get("kind"), "last_seen": last, "seen_ids": [],
                                 "_seeded": "by setup-pair render: NOW, so old messages are never replayed"}, indent=1))
        n += 1
    return n


def record_setup_change(cfg, role, data):
    """A workspace's rules changed (install, render, kit update): record it once in <ledger>/handoffs/setup-changes.jsonl.
    The builder's `handoff notices --steps` offers it to the change channel like any other step (post every change)."""
    import hashlib
    digest = hashlib.sha256(json.dumps(data, sort_keys=True).encode()).hexdigest()[:12]
    f = pairconf.ledger_dir(cfg) / "handoffs" / "setup-changes.jsonl"
    rows = [json.loads(l) for l in f.read_text().splitlines() if l.strip()] if f.exists() else []
    if any(r.get("role") == role and r.get("rules") == digest for r in rows):
        return
    kit = subprocess.run(["git", "-C", str(KIT), "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    f.parent.mkdir(parents=True, exist_ok=True)
    rec = {"ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "role": role,
           "name": pairconf.name(cfg, role), "host": socket.gethostname(), "kit": kit, "rules": digest,
           "repos": len(pairconf.apps(cfg)), "standing": len(pairrules.get(cfg, "rules.standing") or [])}
    with open(f, "a") as fh:
        fh.write(json.dumps(rec) + "\n")
    print(f"recorded setup change for the change channel: {rec['name']} rules {digest}, kit {kit}")


