#!/usr/bin/env python3
"""df-engram — write durable knowledge to Engram from a session, without ever losing it.

WHY THIS EXISTS, and it is a measured failure rather than a worry.

The estate wrote to Engram by hand for months. `pending-engram/README.md` in the onedroid notepad
is the record: NINE `engram_write` calls returned `RPC request timed out`; AT LEAST THREE of them
had in fact committed; each was read back seconds later, found missing, and retried — so duplicates
were created and later deleted by hand. The measured lag between a timeout and the document being
findable is ~60-90 SECONDS.

    ⛔ A TIMEOUT CARRIES NO INFORMATION EITHER WAY. It is not a failure and it is not a success.

Everything below follows from that one sentence:

  1. THE FILE IS WRITTEN FIRST, into <notepad>/pending-engram/. A finding is never lost to a
     network call, a missing token, or a hub that is down.
  2. THE BODY CARRIES AN IDEMPOTENCY KEY (`ENGRAM-KEY <sha256>`), which is also in the front
     matter. It is a nonce, so the keyword leg of search finds it exactly. This is what makes a
     retry safe: `reconcile` can ask "did MY write land?" instead of guessing.
  3. A TIMEOUT PARKS AS `UNPROVEN`, NEVER AS FAILED, AND NEVER RETRIES IN THE SAME RUN.
  4. `reconcile` RESPECTS THE LAG (default 120 s) before it believes an absence.

⚠️ THE HUB'S AGGREGATOR TOOLS ARE NOT USABLE FROM A SCRIPT. Measured 2026-09-22: the bare
`engram_search` returns Go's `map[...]` stringification wrapping the JSON. The `engram-prod__*`
tools return clean JSON with the per-leg scores. This calls the latter, always.

⚠️ TWO SEARCHES, NOT ONE, when looking for neighbours to link. Measured the same day: a real query
returned its top hit with `vector_score 0` (keyword only) while every other hit had `bm25_score 0`
(vector only). Both legs work; a given document usually rides only one of them, so one query finds
half the neighbours.

⚠️ THE GRAPH PROJECTS EDGES AGAIN — re-measured 2026-09-22, and the re-measurement is the only
reason this half of the tool exists. Engram `dde3d4fd` (2026-09-09) recorded the graph layer as
INERT: `engram_link` returned `projection: "pending"`, `engram_neighbors` and `engram_traverse`
stayed empty 45 s later, and `engram_search_graph` reported `graph_available: true` with
`graph_score: 0` on every hit — a FALSE GREEN, which is why nobody noticed. On 2026-09-22 the same
probe returned `projection: "complete"`, the edge read back from `engram_neighbors` IMMEDIATELY
(links do NOT carry the search layer's 60-90 s lag; that lag is indexing, and it is a different
thing), `traverse` returned real paths, and `search_graph` scored `graph_score: 0.52` alongside a
new `graph_contributed: true` — the field that finally makes that false green falsifiable.

    ⛔ THE OLD FINDING WAS NOT WRONG, IT WAS STALE. It was true when it was taken. Anything here
      that claims the graph works is dated for exactly that reason: check the date before trusting
      it, and re-probe before building anything new on top of it.

⚠️ AND THE HUB LINKS ON ITS OWN. The probe found a second edge nobody asked for:
`auto_similar`, `created_by: system:auto_link`, weight 0.92. So embedding-similar neighbours are
ALREADY wired without help. That does not make RELATES_TO redundant — `auto_similar` is computed
from embeddings, so it reproduces the VECTOR leg and misses the keyword-only neighbour entirely,
which is the precise half the two-query search above exists to catch.

What Engram is, and how a machine is authorised to reach it, is documented in exactly one place:
[Engram](../../../starter-kit/instance/AUTHENTICATION.md#engram)

Transport: MCP JSON-RPC over HTTPS to the hub, with a Bearer token named by the config.
That variable lives in a SESSION's environment, so this must run in the session's process tree.
DF_ENGRAM_TRANSPORT=<script> replaces the network call with `<script> <tool> <json-file>` (tests).
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time

QUEUE = "pending-engram"
# ⛔ NO ESTATE ENDPOINT IS HARDCODED HERE, and this is not style. Tier 1 is PUBLIC and generic; a
# hub URL carries an estate's private id. The first version of this file did hardcode one as a
# default and the publish gate's P4 caught it before the merge — which is the gate working, and a
# reminder that "just a default" is how an identifier reaches a public repo.
# Resolution order: DF_ENGRAM_HUB · the server named by DF_ENGRAM_SERVER in the nearest .mcp.json ·
# the only server there, when there is exactly one. Anything else refuses and says what to set.
TOKEN_VAR_DEFAULT = "SYNAPSE_ENGRAM_PAT"
KEY_MARK = "ENGRAM-KEY"
MIN_AGE = float(os.environ.get("DF_ENGRAM_MIN_AGE", "120"))
TIMEOUT_NOTE = ("a timeout proves nothing either way — parked UNPROVEN, not retried. "
                "Run `df-engram reconcile` on a later turn.")


def _mcp_servers(start):
    """The nearest .mcp.json, walking up. Returns {name: {url, headers}} or {}."""
    d = os.path.abspath(start)
    for _ in range(12):
        p = os.path.join(d, ".mcp.json")
        if os.path.isfile(p):
            try:
                with open(p, encoding="utf-8") as f:
                    return json.load(f).get("mcpServers") or {}
            except Exception:
                return {}
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    return {}


def resolve_hub():
    """(url, token_var) or (None, reason). The token VARIABLE NAME is read from the config's
    Authorization header (`Bearer ${VAR}`), never the value — so nothing here holds a secret."""
    env_hub = os.environ.get("DF_ENGRAM_HUB")
    token_var = os.environ.get("DF_ENGRAM_TOKEN_VAR")
    servers = _mcp_servers(os.getcwd())
    name = os.environ.get("DF_ENGRAM_SERVER")
    entry = None
    if name and name in servers:
        entry = servers[name]
    elif not name and len(servers) == 1:
        entry = next(iter(servers.values()))
    if entry and not env_hub:
        env_hub = entry.get("url")
    if entry and not token_var:
        auth = (entry.get("headers") or {}).get("Authorization", "")
        m = re.search(r"\$\{?([A-Z0-9_]+)\}?", auth)
        if m:
            token_var = m.group(1)
    if not env_hub:
        return None, ("no Engram endpoint: set DF_ENGRAM_HUB, or DF_ENGRAM_SERVER to a server in "
                      "the nearest .mcp.json (found: %s)" % (", ".join(sorted(servers)) or "none"))
    return env_hub, (token_var or TOKEN_VAR_DEFAULT)


def find_notepad(start):
    d = os.path.abspath(start)
    for _ in range(12):
        if os.path.isfile(os.path.join(d, "NOTES.md")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    return None


def slug(text, n=60):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return (s[:n] or "record").strip("-")


def key_for(title, body):
    return hashlib.sha256((title + "\n" + body).encode("utf-8")).hexdigest()[:32]


def read_front(path):
    """front matter (`k: v` lines before the first blank line) + the rest."""
    front, rest, in_front = {}, [], True
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if in_front:
                if not line.strip():
                    in_front = False
                    continue
                m = re.match(r"^([a-zA-Z_]+): ?(.*)$", line)
                if m:
                    front[m.group(1)] = m.group(2)
                    continue
                in_front = False
            rest.append(line)
    return front, "\n".join(rest)


def write_front(path, front, body):
    order = ["title", "kind", "collection", "key", "status", "id", "created", "mission", "links"]
    lines = [f"{k}: {front[k]}" for k in order if front.get(k) is not None]
    lines += [f"{k}: {v}" for k, v in front.items() if k not in order and v is not None]
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n\n" + body.rstrip("\n") + "\n")
    os.replace(tmp, path)


def call(tool, args):
    """Returns (ok, parsed_or_text). ok=False means: NOT PROVEN, never 'did not happen'."""
    transport = os.environ.get("DF_ENGRAM_TRANSPORT")
    payload = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
               "params": {"name": tool, "arguments": args}}
    if transport:
        tmp = os.path.join(os.environ.get("TMPDIR", "/tmp"), "df-engram-args.json")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(args, f)
        try:
            r = subprocess.run([transport, tool, tmp], capture_output=True, text=True, timeout=60)
        except Exception as exc:
            return False, str(exc)
        if r.returncode != 0:
            return False, (r.stderr or r.stdout or "transport failed").strip()
        try:
            return True, json.loads(r.stdout)
        except Exception:
            return False, r.stdout.strip()
    hub, token_var = resolve_hub()
    if not hub:
        return False, token_var          # the reason, when hub is None
    token = os.environ.get(token_var)
    if not token:
        return False, f"{token_var} is not set in this environment"
    cmd = ["curl", "-sS", "-m", "90", "-X", "POST", hub,
           "-H", f"Authorization: Bearer {token}",
           "-H", "Accept: application/json, text/event-stream",
           "-H", "Content-Type: application/json",
           "-d", json.dumps(payload)]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except Exception as exc:
        return False, str(exc)
    if r.returncode != 0:
        return False, (r.stderr or "curl failed").strip()
    try:
        d = json.loads(r.stdout)
        if "error" in d:
            return False, json.dumps(d["error"])[:300]
        text = d["result"]["content"][0]["text"]
        return True, json.loads(text)
    except Exception:
        return False, r.stdout[:300]


ANCHOR_REL = "anchors"                       # <notepad>/.df/engram-anchor.json
MIN_SCORE = float(os.environ.get("DF_ENGRAM_MIN_SCORE", "0.35"))


def anchor_path(notepad):
    return os.path.join(notepad, ".df", "engram-anchor.json")


def read_anchors(notepad):
    try:
        with open(anchor_path(notepad), encoding="utf-8") as f:
            d = json.load(f)
    except Exception:
        return {}
    return d if isinstance(d, dict) else {}


def write_anchors(notepad, data):
    p = anchor_path(notepad)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, p)


def anchor_collection(a=None):
    return (getattr(a, "collection", None) or os.environ.get("DF_ENGRAM_ANCHOR_COLLECTION")
            or "loom-sessions")


def notepad_blurb(notepad):
    """The anchor's body: what this notepad is FOR and what it drives. Read from the notepad's own
    files, never invented — an anchor that describes the notepad wrongly is worse than none."""
    name = os.path.basename(notepad.rstrip("/"))
    lines = [f"Agent-notepad `{name}` at `{notepad}`.", ""]
    scope = os.path.join(notepad, "SCOPE.md")
    if os.path.isfile(scope):
        head = []
        with open(scope, encoding="utf-8") as f:
            for line in f:
                if len(head) >= 12:
                    break
                if line.strip():
                    head.append(line.rstrip("\n"))
        lines += ["## Objective (from SCOPE.md)", ""] + head + [""]
    man = os.path.join(notepad, "repos.manifest.json")
    if os.path.isfile(man):
        try:
            with open(man, encoding="utf-8") as f:
                d = json.load(f)
            repos = d.get("repos") or []
            names = [r.get("name") or r.get("repo") for r in repos if isinstance(r, dict)]
            names = [n for n in names if n]
            if names:
                lines += ["## Repos it drives", ""] + [f"- {n}" for n in sorted(names)] + [""]
        except Exception:
            pass
    lines += ["This document is a GRAPH ANCHOR. Records written from this notepad link to it with "
              "`RECORDED_BY_NOTEPAD`, so another session reaches this notepad's knowledge by "
              "expanding from here.", ""]
    return "\n".join(lines)


def ensure_notepad_anchor(notepad, a, quiet=False):
    """(id, created, note). Idempotent: an id already on disk is never re-created."""
    data = read_anchors(notepad)
    have = (data.get("notepad") or {}).get("id")
    if have:
        return have, False, "already recorded"
    name = os.path.basename(notepad.rstrip("/"))
    title = f"Notepad: {name}"
    coll = anchor_collection(a)
    okc, res = call("engram-prod__engram_write",
                    {"collection": coll, "title": title, "kind": "document",
                     "content": notepad_blurb(notepad)})
    if not (okc and isinstance(res, dict) and res.get("id")):
        return None, False, str(res)[:200]
    data["notepad"] = {"name": name, "title": title, "collection": coll, "id": res["id"],
                       "created": str(int(time.time()))}
    write_anchors(notepad, data)
    return res["id"], True, "created"


def ensure_mission_anchor(notepad, mission, a):
    """(id, created, note). Linked FROM_NOTEPAD -> the notepad anchor, so a mission is never an
    island. Idempotent per mission id."""
    np_id, _, np_note = ensure_notepad_anchor(notepad, a)
    if not np_id:
        return None, False, f"no notepad anchor ({np_note})"
    data = read_anchors(notepad)
    missions = data.setdefault("missions", {})
    have = (missions.get(mission) or {}).get("id")
    if have:
        return have, False, "already recorded"
    name = os.path.basename(notepad.rstrip("/"))
    title = f"Mission: {mission} — {name}"
    coll = anchor_collection(a)
    body = (f"Mission `{mission}`, run from agent-notepad `{name}`.\n\n"
            f"GRAPH ANCHOR. Records produced by this mission link here with `FROM_MISSION`; "
            f"this document links to the notepad anchor with `FROM_NOTEPAD`.\n")
    okc, res = call("engram-prod__engram_write",
                    {"collection": coll, "title": title, "kind": "document", "content": body})
    if not (okc and isinstance(res, dict) and res.get("id")):
        return None, False, str(res)[:200]
    mid = res["id"]
    lok, lres = link(mid, np_id, "FROM_NOTEPAD")
    missions[mission] = {"title": title, "collection": coll, "id": mid,
                         "from_notepad": "ok" if lok else f"FAILED: {str(lres)[:80]}",
                         "created": str(int(time.time()))}
    write_anchors(notepad, data)
    return mid, True, ("created" if lok else f"created, but FROM_NOTEPAD failed: {str(lres)[:80]}")


def link(from_id, to_id, relation):
    if not from_id or not to_id or from_id == to_id:
        return False, "refused: an edge needs two different ids"
    return call("engram-prod__engram_link",
                {"from_id": from_id, "to_id": to_id, "relation": relation})


def _hits(res):
    """Normalise a search result to [(id, title, score)] across both tools' shapes."""
    out = []
    if not isinstance(res, dict):
        return out
    for r in res.get("results") or []:
        if not isinstance(r, dict):
            continue
        rid = r.get("document_id") or r.get("object_id") or r.get("id")
        if not rid:
            continue
        title = r.get("document_title") or r.get("title") or ""
        try:
            score = float(r.get("score") or r.get("merged_score") or 0)
        except Exception:
            score = 0.0
        out.append((rid, title, score))
    return out


def two_leg_search(query_kw, query_vec, collection, limit=10):
    """⛔ TWO queries, because the legs fire separately (see the module docstring). Returns the
    UNION, best score per id, ordered by score. One query finds about half of these."""
    seen = {}
    for q in [q for q in (query_kw, query_vec) if q]:
        okc, res = call("engram-prod__engram_search",
                        {"query": q, "collection": collection, "limit": limit,
                         "min_score": MIN_SCORE})
        if not okc:
            continue
        for rid, title, score in _hits(res):
            if rid not in seen or score > seen[rid][1]:
                seen[rid] = (title, score)
    return sorted(([rid, t, s] for rid, (t, s) in seen.items()), key=lambda r: -r[2])


def wire_record(notepad, doc_id, a, mission, relates_query, title, collection):
    """Link a written record into the graph. Returns a summary string for the queue file.

    ⛔ NEVER CALLED WITHOUT A doc_id. An UNPROVEN write has no id, and inventing one would put a
    phantom node in the graph; reconcile wires it up later, once the id is known.
    ⛔ A LINK FAILURE IS RECORDED, NEVER SWALLOWED — the record itself is already written, so the
    failure must not look like success and must not undo the write."""
    parts = []
    np_id = (read_anchors(notepad).get("notepad") or {}).get("id")
    if np_id:
        okc, res = link(doc_id, np_id, "RECORDED_BY_NOTEPAD")
        parts.append("RECORDED_BY_NOTEPAD=ok" if okc else f"RECORDED_BY_NOTEPAD=FAILED({str(res)[:40]})")
    if mission:
        m_id = ((read_anchors(notepad).get("missions") or {}).get(mission) or {}).get("id")
        if m_id:
            okc, res = link(doc_id, m_id, "FROM_MISSION")
            parts.append("FROM_MISSION=ok" if okc else f"FROM_MISSION=FAILED({str(res)[:40]})")
        else:
            parts.append("FROM_MISSION=no-anchor")
    n_ok, n_bad = 0, 0
    for rid, _t, _s in two_leg_search(title, relates_query, collection)[:8]:
        if rid == doc_id:            # ⛔ a fresh record can rank as its own top hit
            continue
        if n_ok >= 3:
            break
        okc, _res = link(doc_id, rid, "RELATES_TO")
        if okc:
            n_ok += 1
        else:
            n_bad += 1
    parts.append(f"RELATES_TO={n_ok}" + (f" FAILED={n_bad}" if n_bad else ""))
    for cid in (getattr(a, "corrects", None) or []):
        okc, res = link(doc_id, cid, "CORRECTS")
        parts.append(f"CORRECTS[{cid[:8]}]=" + ("ok" if okc else f"FAILED({str(res)[:40]})"))
    return " ".join(parts)


def cmd_anchor(a, notepad):
    np_id, created, note = ensure_notepad_anchor(notepad, a)
    if not np_id:
        sys.stderr.write(f"df-engram: the notepad anchor was NOT recorded — {note}\n"
                         "Nothing was written to disk, so a later run retries cleanly.\n")
        return 3
    print(f"df-engram: notepad anchor {np_id} ({note}) -> {anchor_path(notepad)}")
    if a.mission:
        m_id, _c, m_note = ensure_mission_anchor(notepad, a.mission, a)
        if not m_id:
            sys.stderr.write(f"df-engram: the mission anchor for {a.mission} was NOT recorded — "
                             f"{m_note}\n")
            return 3
        print(f"df-engram: mission anchor {m_id} for {a.mission} ({m_note})")
    return 0


def cmd_recall(a, notepad):
    """Ids and titles, never content — the restore budget is contended and a wall of Engram text
    pushes NOTES.md out of the window. Content is fetched on demand, by id."""
    rows = two_leg_search(a.topic, a.paraphrase or a.topic, a.collection, limit=a.limit)
    okc, res = call("engram-prod__engram_search_graph",
                    {"query": a.topic, "collection": a.collection, "limit": a.limit,
                     "min_score": MIN_SCORE})
    if okc:
        have = {r[0] for r in rows}
        rows += [[rid, t, s] for rid, t, s in _hits(res) if rid not in have]
    if not rows:
        print("df-engram: nothing above the score floor. That is an absence of HITS, not of "
              "knowledge — try other words before concluding it is not there.")
        return 0
    out, used = [], 0
    for rid, title, _s in rows[:a.limit]:
        line = f"{rid[:8]}  {title}"[:200]
        if a.budget and used + len(line) + 1 > a.budget:
            break
        out.append(line)
        used += len(line) + 1
    sys.stdout.write("\n".join(out) + "\n")
    return 0


def cmd_write(a, notepad):
    body = a.body
    if a.body_file:
        body = open(a.body_file, encoding="utf-8").read()
    k = key_for(a.title, body)
    body_with_key = body.rstrip("\n") + f"\n\n{KEY_MARK} {k}\n"
    qdir = os.path.join(notepad, QUEUE)
    os.makedirs(qdir, exist_ok=True)
    path = os.path.join(qdir, f"{slug(a.title)}-{k[:8]}.md")
    front = {"title": a.title, "kind": a.kind, "collection": a.collection, "key": k,
             "status": "PENDING", "created": str(int(time.time())), "mission": a.mission}
    # THE FILE FIRST. Everything after this can fail without losing the finding.
    write_front(path, front, body_with_key)
    if not os.environ.get("DF_ENGRAM_TRANSPORT"):
        hub, token_var = resolve_hub()
        if not hub or not os.environ.get(token_var):
            front["status"] = "UNPROVEN"
            write_front(path, front, body_with_key)
            why = token_var if not hub else f"{token_var} is not set in this environment"
            sys.stderr.write(
                f"df-engram: nothing was sent — {why}.\n"
                f"The finding is QUEUED at {path} — run `df-engram reconcile` from a session that has it.\n")
            return 3
    okc, res = call("engram-prod__engram_write",
                    {"collection": a.collection, "title": a.title, "kind": a.kind,
                     "content": body_with_key})
    if okc and isinstance(res, dict) and res.get("id"):
        front["status"], front["id"] = "written", res["id"]
        write_front(path, front, body_with_key)
        # The record exists now. The graph is a SECOND concern: it must not be able to undo that,
        # and it must not be able to fail quietly either.
        front["links"] = wire_record(notepad, res["id"], a, a.mission, a.relates_query,
                                     a.title, a.collection)
        write_front(path, front, body_with_key)
        print(f"df-engram: written {res['id']} -> {a.collection} ({path})")
        print(f"  links: {front['links']}")
        if "FAILED" in front["links"]:
            print("  ⚠️ the RECORD is written; some EDGES are not. Re-run `df-engram anchor` and "
                  "link again, or repair by id — the record is not lost either way.")
        return 0
    front["status"] = "UNPROVEN"
    write_front(path, front, body_with_key)
    print(f"df-engram: UNPROVEN — {TIMEOUT_NOTE}\n  detail: {str(res)[:200]}\n  queued: {path}")
    return 0


def _hit_id(res, key):
    """A search result that CONTAINS OUR KEY is proof our write landed. Anything else is not."""
    if not isinstance(res, dict):
        return None
    for r in res.get("results") or []:
        blob = json.dumps(r)
        if key in blob:
            return r.get("document_id") or r.get("id")
    return None


def cmd_reconcile(a, notepad):
    qdir = os.path.join(notepad, QUEUE)
    if not os.path.isdir(qdir):
        print("df-engram: nothing queued.")
        return 0
    now, touched = time.time(), 0
    for name in sorted(os.listdir(qdir)):
        if not name.endswith(".md"):
            continue
        path = os.path.join(qdir, name)
        front, body = read_front(path)
        if front.get("status") != "UNPROVEN" or not front.get("key"):
            continue
        age = now - float(front.get("created") or 0)
        if age < MIN_AGE:
            print(f"df-engram: {name} is too recent ({int(age)}s < {int(MIN_AGE)}s) — "
                  "an absence this early is a FALSE NEGATIVE, not an absence. Leaving it.")
            continue
        touched += 1
        okc, res = call("engram-prod__engram_search",
                        {"query": front["key"], "collection": front.get("collection")})
        found = _hit_id(res, front["key"]) if okc else None
        if found:
            front["status"], front["id"] = "written", found
            write_front(path, front, body)
            front["links"] = wire_record(notepad, found, a, front.get("mission"),
                                         None, front.get("title") or "",
                                         front.get("collection"))
            write_front(path, front, body)
            print(f"df-engram: {name} DID land as {found} — recorded, not rewritten.")
            print(f"  links: {front['links']}")
            continue
        if not okc:
            print(f"df-engram: {name} — search itself failed ({str(res)[:120]}). Still UNPROVEN.")
            continue
        okc, res = call("engram-prod__engram_write",
                        {"collection": front.get("collection"), "title": front.get("title"),
                         "kind": front.get("kind") or "knowledge", "content": body})
        if okc and isinstance(res, dict) and res.get("id"):
            front["status"], front["id"] = "written", res["id"]
            write_front(path, front, body)
            front["links"] = wire_record(notepad, res["id"], a, front.get("mission"),
                                         None, front.get("title") or "",
                                         front.get("collection"))
            write_front(path, front, body)
            print(f"df-engram: {name} retried and written as {res['id']}.")
            print(f"  links: {front['links']}")
        else:
            print(f"df-engram: {name} still UNPROVEN — {TIMEOUT_NOTE}")
    if not touched:
        print("df-engram: nothing old enough to reconcile.")
    return 0


def main():
    p = argparse.ArgumentParser(prog="df-engram", description=__doc__.split("\n")[0],
                                epilog=f"Queue: <notepad>/{QUEUE}/ — the file is written BEFORE the "
                                       "hub call, so a finding is never lost.")
    p.add_argument("--notepad", help="notepad root (default: walk up from cwd for NOTES.md)")
    sub = p.add_subparsers(dest="cmd", required=True)

    w = sub.add_parser("write", help="queue a record, then write it to Engram")
    w.add_argument("--title", required=True)
    w.add_argument("--kind", required=True)
    w.add_argument("--collection", required=True)
    w.add_argument("--body", default="")
    w.add_argument("--body-file")
    w.add_argument("--mission")
    w.add_argument("--relates-query", dest="relates_query",
                   help="a ONE-SENTENCE paraphrase of the finding. ⛔ This is the second search "
                        "leg: the title finds keyword neighbours, this finds vector ones. Omit it "
                        "and half the neighbours go unlinked.")
    w.add_argument("--corrects", action="append", default=[], metavar="ID",
                   help="a document this one supersedes (repeatable). Never inferred — a CORRECTS "
                        "edge is a claim, so it is only ever made because you named the id.")
    w.set_defaults(func=cmd_write)

    r = sub.add_parser("reconcile", help="re-probe UNPROVEN writes by their key, after the lag")
    r.set_defaults(func=cmd_reconcile)

    an = sub.add_parser("anchor", help="ensure this notepad's (and a mission's) graph anchor")
    an.add_argument("--mission", help="also ensure the anchor for this mission id")
    an.add_argument("--collection", help=f"namespace for anchors (default: {anchor_collection()})")
    an.set_defaults(func=cmd_anchor)

    rc = sub.add_parser("recall", help="ids and titles for a topic — both search legs, plus graph")
    rc.add_argument("topic")
    rc.add_argument("--paraphrase", help="the second leg; defaults to the topic itself")
    rc.add_argument("--collection")
    rc.add_argument("--limit", type=int, default=5)
    rc.add_argument("--budget", type=int, default=0,
                    help="cap the output in BYTES (the SessionStart budget is ~400)")
    rc.set_defaults(func=cmd_recall)

    a = p.parse_args()
    notepad = a.notepad or find_notepad(os.getcwd())
    if not notepad:
        sys.stderr.write("df-engram: no notepad found (walked up for NOTES.md). Use --notepad.\n")
        return 2
    return a.func(a, notepad)


if __name__ == "__main__":
    sys.exit(main() or 0)
