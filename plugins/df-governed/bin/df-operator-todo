#!/usr/bin/env python3
"""df-operator-todo — the single page of work the HUMAN owes, maintained by the agent.

WHY THIS EXISTS. The governed loop already refuses to hand work back that was never the
operator's (`escalation-gate.py`) and refuses to stop without enumerating what was deferred
(`handoff-completeness-gate.py`). Both produce the same artefact and neither KEEPS it: the
operator-only items land in a transcript, a mission escalation file, or the tail of a handoff,
and a human who steps away for a day has to reconstruct their own to-do list from three places.
Operator attention is the only non-replenishable input in this method; making a human re-derive
their own queue spends it on retrieval.

So: ONE file, at the notepad root, next to NOTES.md. The agent writes it. The human works it,
asynchronously, while the loop keeps running.

⚠️ NO HISTORY IN THE FILE — AND THAT IS NOT THE SAME AS NO HISTORY.
The operator asked for no history: a finished task is DELETED, not struck through, not moved to
a "Done" section that grows forever. This file is a FRONTIER, not a log, and a frontier that
accumulates its own past stops being readable at a glance — which is the entire feature.
⚠️ This deliberately sits against a rule the rest of this estate applies hard, that an entry
which simply vanishes reads as one nobody decided (see repos.manifest.json, four separate
recorded instances). The reconciliation is that THE NOTEPAD IS A GIT REPO: every removal is a
commit, so the history is complete and durable in `git log -p operator-todo.md` while the file
itself stays short. History lives where history belongs, not in the working page.

⚠️ THE AGENT MAY NOT TICK OFF WORK IT DID NOT WATCH HAPPEN. `done` requires either --verified
with evidence, or --by-operator when the human says so. An agent that removes an item because
it ASSUMES the human did it produces the one failure this file cannot survive: a task that
silently leaves the queue while still undone. Same rule as everywhere else here — verify the
evidence, never the self-report, and never your own optimism.

USAGE
  df-operator-todo add  --id <slug> --category <cat> --task "<what>" --why "<why it is theirs>" \
                        --context "<what this is about, in plain English>" \
                        --do "<the exact command/URL/PR>" [--blocking] [--ref <path|url>]
  df-operator-todo done --id <slug> (--verified "<evidence>" | --by-operator)
  df-operator-todo list [--blocking-only]
  df-operator-todo publish   render this page to HTML and update the ONE page he reads, in place
  df-operator-todo publish --check    exit 1 if what he can read is older than this file
  df-operator-todo init      create the empty page at the notepad root if absent (idempotent)
  df-operator-todo path

  --blocking  the loop cannot proceed until this is done. Default is ASYNC: the loop keeps
              going and the human picks it up when convenient, which is the normal case and
              the reason this file exists at all.

--category IS THE ADMISSION TEST, and it is why this file stays short. Operator ruling
2026-09-09: this page holds ONLY "active open actions waiting for the human operator (decisions,
approval, credential grants etc)". The set below is closed ON PURPOSE and is the same list the
work-autonomously stance already uses: NAME THE OPERATOR-ONLY THING THIS ITEM NEEDS, and if none
of these is it, the item was never theirs — it is yours, so go and do it.

  decision      a judgement only they can make (a new risk accepted, a policy, a trade-off)
  approval      permission for an act you are otherwise able to perform
  credential    a secret, a login, a token, an account only they hold
  access        someone else's machine or account you genuinely cannot reach
  irreversible  an outward-facing or unrecoverable act (prod, publishing, spend, a merge you
                are not authorised for)
  attention     a real dead end after memory, the codebase, the internet and the docs

⛔ WHAT IS NOT AN ITEM, however true it is: an FYI · a status report · "nothing to do unless you
want it sooner" · a thing you have already done · a defect you are able to fix · a wait for a
timer or a rate limit. Those go in the notes, the journal, or the report. An item nobody has to
ACT on trains the reader to skim the ones they do.

IDS ARE THE DEDUPE KEY. Re-adding an existing id UPDATES that entry in place rather than
appending a second copy. A loop that runs for six hours and re-derives the same blocker every
iteration must not produce six identical lines; it must produce one, still true.
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone

FILENAME = "operator-todo.md"

# The closed set. Deliberately the same list work-autonomously uses for "what stays the
# operator's", so an item that fits none of these is one the agent should have done itself.
CATEGORIES = {
    "decision": "a judgement only they can make",
    "approval": "permission for an act you can otherwise perform",
    "credential": "a secret, login or account only they hold",
    "access": "someone else's machine or account you cannot reach",
    "irreversible": "an outward-facing or unrecoverable act",
    "attention": "a real dead end, after the toolchain",
}

HEADER = """# Operator TODO

<!-- MAINTAINED BY THE AGENT (df-governed / df-operator-todo). This is your queue, not a log.

     NO HISTORY BY DESIGN: a finished task is DELETED from this file, never struck through and
     never moved to a "Done" section. The file is the FRONTIER. The history is complete in git
     (`git log -p operator-todo.md`) — it just does not live on this page.

     You can work these in any order, asynchronously; the loop keeps running without you unless
     an item is marked BLOCKING. Delete a line yourself the moment it is done, or tell the agent
     and it will — but it will not remove one on a guess.

     EVERY ITEM OPENS WITH CONTEXT, IN PLAIN ENGLISH — what the thing is, and what breaks or
     stays broken until you decide it. You should never have to decode an id, a PR number or a
     gate code to find out what you are being asked. If an item does not read that way, it is a
     defect on this page — say so and it gets rewritten. (Operator ruling 2026-10-21.)

     EVERY LINE HERE IS AN ACTION WAITING ON YOU — a decision, an approval, a credential, access
     to a machine that is not ours, an irreversible act, or your judgement on a real dead end.
     Nothing else is admitted: no status, no FYI, no "nothing to do unless you want it sooner".
     If a line does not need you to DO something, it is a defect on this page — say so and it
     goes. (Operator ruling 2026-09-09.) -->
"""

BLOCKING_H = "## ⛔ Blocking — the loop is stopped until you do these"
ASYNC_H = "## Async — the loop continues without these"
EMPTY_BLOCKING = "_Nothing blocking. The loop is not waiting on you._"
EMPTY_ASYNC = "_Nothing queued._"

ENTRY_RE = re.compile(r"^- \[ \] `(?P<id>[^`]+)` — (?P<rest>.*)$")
CLOSED_RE = re.compile(r"^\s*- \[[xX]\]")
# A decision's choices, one indented line each, under its entry line. The only continuation
# lines the page admits: anything else indented under an item is narration and fails lint.
# Operator ruling 2026-10-21: "I want to make sure that any question I'm asked and decisions I
# have to make are presented to me with context in plain English, always."
#
# The page already carried WHAT is being asked (`--task`), WHY it is his (`--why`), the choices
# and a recommendation. None of those say what the thing IS. An operator reading
# `t1-230-credit-line` had to reconstruct the subject from an id, a PR number and a gate code
# before he could even reach the decision. `--context` is that missing sentence, it is REQUIRED on
# every item whatever its category, and it is rendered FIRST so it is read before the options.
CONTEXT_P = "  - **Context:** "
OPTION_P = "  - **Option:** "
RECOMMEND_P = "  - **Recommendation:** "
# An operator ACTION's how-to, one numbered line per step (operator ruling 2026-09-22, second
# half: "if I need to create a github token, I want to see a brief step by step instruction:
# click here, run this command, etc."). A `--do` sentence left him to work out the clicks himself.
STEP_RE = re.compile(r"^  \d+\. ")
MAX_STEPS = 10
RAISED_RE = re.compile(r" · _raised (\d{4}-\d{2}-\d{2})_$")

# Operator ruling 2026-09-22: "only open items should be present in the file. It should be
# cleared of closed items, any narration or history not relevant to the open issues." Measured
# that day: three live pages at 28 KB, 50 KB and 35 KB, one 11-item page averaging 2.5 KB per
# item, each item a trail of "RE-CHECKED …", "✅ … ARE MERGED", "corrected …". The tool never
# wrote those; sessions hand-edited them in. So the caps bind at `add` AND `lint` reads the page.
CAPS = {"task": 200, "why": 400, "do": 600, "option": 400, "recommend": 400, "ref": 300,
        "step": 300, "context": 600}
ITEM_CAP = 1500
HISTORY_RE = re.compile(
    # The dated forms only: "rewritten 2026-09-15" is a trail, "until it is rewritten" is a step
    # still to come and "not re-checked from this box" is a caveat. Both of the latter were
    # flagged by the first version of this pattern on the first real page written with it.
    r"✅|~~|\b(?:re-?(?:checked|measured|probed|tested|raised)|rewritten|corrected|narrowed|"
    r"extended)[ ,:]+(?:on )?\d{4}-\d{2}-\d{2}|\bsuperseded\b|"
    r"\bused to\b|\bwas wrong\b|\bsame day\b|"
    r"\b(?:is|are|was|were) (?:now |already )?(?:merged|closed|done|fixed|resolved)\b",
    re.IGNORECASE)
DATE_RE = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")


def find_notepad(start):
    """Walk up for NOTES.md — the notepad root marker (the directory NAME is never parsed)."""
    d = os.path.abspath(start)
    while True:
        if os.path.isfile(os.path.join(d, "NOTES.md")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def todo_path(explicit=None):
    if explicit:
        return explicit
    np = find_notepad(os.environ.get("DF_NOTEPAD") or os.getcwd())
    if not np:
        sys.stderr.write(
            "df-operator-todo: no notepad found (walked up from cwd for NOTES.md).\n"
            "This file belongs at a notepad root. Run it from inside one, or set DF_NOTEPAD.\n")
        sys.exit(2)
    return os.path.join(np, FILENAME)


def parse(path):
    """Return (blocking, async_) as lists of (id, rest, extra), where `extra` is the entry's
    option/recommendation lines. Unknown lines outside the two sections are dropped on rewrite —
    the file is generated, and a hand-edited line that the parser cannot round-trip would be
    silently corrupted instead. Deleting a whole `- [ ]` item by hand IS supported and is the
    documented way for a human to close an item."""
    if not os.path.isfile(path):
        return [], []
    blocking, async_, cur = [], [], None
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if line.startswith(BLOCKING_H):
                cur = blocking
                continue
            if line.startswith(ASYNC_H):
                cur = async_
                continue
            m = ENTRY_RE.match(line)
            if m and cur is not None:
                cur.append((m.group("id"), m.group("rest"), []))
                continue
            if cur and (line.startswith((CONTEXT_P, OPTION_P, RECOMMEND_P))
                        or STEP_RE.match(line)):
                cur[-1][2].append(line)
    return blocking, async_


def _lines(entries):
    out = []
    for i, r, extra in entries:
        out.append(f"- [ ] `{i}` — {r}")
        out.extend(extra)
    return "\n".join(out)


def render(blocking, async_):
    out = [HEADER, "", BLOCKING_H, ""]
    out.append(_lines(blocking) if blocking else EMPTY_BLOCKING)
    out += ["", ASYNC_H, ""]
    out.append(_lines(async_) if async_ else EMPTY_ASYNC)
    out.append("")
    return "\n".join(out)


def write(path, blocking, async_):
    with open(path, "w", encoding="utf-8") as f:
        f.write(render(blocking, async_))


def _plain_enough(text):
    """Is this a sentence a person can read, or an identifier dump?

    The bar is deliberately LOW. This is not a style police: it exists to catch a "context" like
    `FAIL P6 at builder-tester-pair/README.md:96` — true, and unreadable to anyone who was not
    already in the work. It counts PROSE words (no slash, backslash, backtick, underscore, angle
    bracket, equals or digit, and not an ALL-CAPS slug) and asks for a handful of them.

    ⚠️ A low bar that fires on the real failure beats a clever one that argues with good writing.
    Both directions are covered by test-df-operator-todo.sh: a jargon dump must be refused and an
    ordinary sentence must pass, because a check that cannot fail is not a check.
    """
    words = text.split()
    if len(words) < 8:
        return False, f"it is {len(words)} words long"
    prose = 0
    for w in words:
        t = w.strip("`*_.,;:()[]\"'")
        if not t:
            continue
        if any(c in t for c in "/\\`_<>=") or any(c.isdigit() for c in t):
            continue
        if t.isupper() and len(t) > 2:
            continue
        prose += 1
    if prose < 5:
        return False, f"only {prose} of its {len(words)} words are plain English"
    return True, ""


def _refuse(msg):
    sys.stderr.write("df-operator-todo: " + msg + "\n")
    return 2


def cmd_add(a):
    options = a.option or []
    steps = a.step or []
    ok, why = _plain_enough(a.context)
    if not ok:
        return _refuse(
            "--context is not plain English yet: " + why + ".\n"
            "Two sentences, no jargon, as if to someone who has not seen this work: what the "
            "thing IS, and what breaks or stays broken until it is decided.\n"
            "An id, a PR number and a gate code are not context — the operator should not have "
            "to reconstruct the subject before he can reach the question (ruling 2026-10-21).")
    if a.category == "decision" and (len(options) < 2 or not a.recommend):
        return _refuse(
            "a decision needs at least two --option \"<choice>: <what it means and what follows>\" "
            "and one --recommend \"<which, and why>\".\nA decision without them hands the operator "
            "the analysis as well as the choice (operator ruling 2026-09-22).")
    if a.category != "decision" and not steps:
        return _refuse(
            "an operator action needs its steps: one --step per action, in plain English, in "
            "order — the page to open (full URL), what to click, the exact command to run, what "
            "to paste where, and what they should see when it worked.\nA sentence saying WHAT to "
            "do leaves the operator to work out HOW (operator ruling 2026-09-22).")
    if a.category == "decision" and not a.do and not steps:
        return _refuse("a decision needs --do: how to answer (e.g. \"Reply A or B\").")
    if len(steps) > MAX_STEPS:
        return _refuse(f"{len(steps)} steps; the cap is {MAX_STEPS}. Link a runbook with --ref.")
    fields = [("task", a.task), ("why", a.why), ("context", a.context),
              ("do", a.do or ""), ("ref", a.ref or ""),
              ("recommend", a.recommend or "")] + [("option", o) for o in options] \
        + [("step", s) for s in steps]
    for name, val in fields:
        if len(val) > CAPS[name]:
            return _refuse(
                f"--{name} is {len(val)} characters; the cap is {CAPS[name]}. An item is an ask, "
                "not an essay: put the evidence in NOTES.md or a handoff and point at it with --ref.")
        if "\n" in val:
            return _refuse(f"--{name} contains a newline; every field is one line.")
    path = todo_path(a.file)
    blocking, async_ = parse(path)
    # The FIRST raised date is kept on a re-add: how long an item has waited is the one piece of
    # history the operator needs, and a trail of "rewritten …, re-checked …" dates is not.
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    for i, r, _ in blocking + async_:
        m = RAISED_RE.search(r)
        if i == a.id and m:
            stamp = m.group(1)
    rest = f"**{a.task}** · _yours because:_ **{a.category}** — {a.why}"
    if a.do:
        rest += f" · _do:_ {a.do}"
    if a.ref:
        rest += f" · _ref:_ {a.ref}"
    rest += f" · _raised {stamp}_"
    extra = [CONTEXT_P + a.context]
    extra += [OPTION_P + o for o in options]
    if a.recommend:
        extra.append(RECOMMEND_P + a.recommend)
    extra += [f"  {n}. {s}" for n, s in enumerate(steps, 1)]
    # An id is unique across BOTH sections: re-adding with a changed --blocking must MOVE the
    # entry, not leave a stale twin in the other section saying the opposite about urgency.
    blocking = [e for e in blocking if e[0] != a.id]
    async_ = [e for e in async_ if e[0] != a.id]
    (blocking if a.blocking else async_).append((a.id, rest, extra))
    write(path, blocking, async_)
    print(f"operator-todo: {'BLOCKING' if a.blocking else 'async'} item `{a.id}` recorded -> {path}")


def cmd_done(a):
    if not a.verified and not a.by_operator:
        sys.stderr.write(
            "df-operator-todo: refusing to close `%s` without --verified <evidence> or "
            "--by-operator.\nRemoving an item you did not watch complete is how a task leaves "
            "the queue while still undone.\n" % a.id)
        return 2
    path = todo_path(a.file)
    blocking, async_ = parse(path)
    before = len(blocking) + len(async_)
    blocking = [e for e in blocking if e[0] != a.id]
    async_ = [e for e in async_ if e[0] != a.id]
    if len(blocking) + len(async_) == before:
        sys.stderr.write(f"df-operator-todo: no open item with id `{a.id}` — nothing removed.\n")
        return 1
    write(path, blocking, async_)
    how = "operator says so" if a.by_operator else f"verified: {a.verified}"
    print(f"operator-todo: `{a.id}` removed ({how}). History is in git, not in the file.")
    return 0


def cmd_init(a):
    """Create the empty page if it is absent. NEVER touches an existing one — not even to
    re-render it, because a page the operator is editing by hand must not be rewritten under him.

    Operator ruling 2026-09-10: "are we automatically creating operator-todo.md for each dark
    factory notepad when we run a new mission, on each estate?" — measured then: NO. The page
    was created lazily by the first `add`, so a mission that raised nothing had no page, and a
    reader could not tell "nothing is waiting on you" from "this estate never set one up".
    Called by the Stop gate for every RUNNING mission and by `df-mission start`, so the page
    exists from the mission's first turn. The header text keeps ONE home: this file."""
    path = todo_path(a.file)
    if os.path.exists(path):
        print(f"operator-todo: already present -> {path}")
        return 0
    write(path, [], [])
    print(f"operator-todo: created -> {path}")
    return 0


def cmd_list(a):
    path = todo_path(a.file)
    blocking, async_ = parse(path)
    if a.blocking_only:
        async_ = []
    if not blocking and not async_:
        print("operator-todo: empty — the operator owes nothing.")
        return 0
    for label, items in (("BLOCKING", blocking), ("async", async_)):
        for i, r, extra in items:
            print(f"[{label}] {i} :: {r}")
            for x in extra:
                print("    " + x.strip())
    return 0


def lint_page(path):
    """Return the page's defects as a list of strings ([] = clean), or None if there is no page.

    Reads the RAW file, not the parse: the parser drops what it cannot round-trip, and what it
    drops (narration, a ticked item, an indented status note) is exactly what this looks for."""
    if not os.path.isfile(path):
        return None
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        raw = f.read().split("\n")
    problems, items, in_comment, cur = [], [], False, None
    allowed = {"# Operator TODO", EMPTY_BLOCKING, EMPTY_ASYNC, ""}
    for n, line in enumerate(raw, 1):
        if in_comment:
            in_comment = "-->" not in line
            continue
        if line.lstrip().startswith("<!--"):
            in_comment = "-->" not in line
            continue
        if CLOSED_RE.match(line):
            problems.append(f"line {n}: a ticked (closed) item — closed items are DELETED, not ticked")
            cur = None
            continue
        m = ENTRY_RE.match(line)
        if m:
            cur = {"id": m.group("id"), "text": m.group("rest"), "options": 0, "rec": 0,
                   "steps": 0, "context": 0,
                   "decision": "_yours because:_ **decision**" in line}
            items.append(cur)
            continue
        if cur is not None and STEP_RE.match(line):
            cur["text"] += " " + line
            cur["steps"] += 1
            continue
        if cur is not None and line.startswith(CONTEXT_P):
            cur["text"] += " " + line
            cur["context"] += 1
            continue
        if cur is not None and line.startswith((OPTION_P, RECOMMEND_P)):
            cur["text"] += " " + line
            cur["options" if line.startswith(OPTION_P) else "rec"] += 1
            continue
        if line.strip() == "":
            continue
        if line.startswith((BLOCKING_H, ASYNC_H)) or line.strip() in allowed:
            cur = None
            continue
        problems.append(f"line {n}: text outside any item (narration or history): {line.strip()[:80]!r}")
    for it in items:
        where = f"`{it['id']}`"
        hit = HISTORY_RE.search(it["text"])
        if hit:
            problems.append(f"{where}: carries history/status ({hit.group(0)!r}) — keep only what is still open")
        if len(set(DATE_RE.findall(it["text"]))) > 2:
            problems.append(f"{where}: carries a trail of dates — keep one raised date")
        if len(it["text"]) > ITEM_CAP:
            problems.append(f"{where}: {len(it['text'])} characters; the cap is {ITEM_CAP}")
        if it["context"] < 1:
            problems.append(f"{where}: no Context line — the operator has to work out what this is "
                            "about before he can answer it (ruling 2026-10-21)")
        if it["decision"] and (it["options"] < 2 or it["rec"] < 1):
            problems.append(f"{where}: a decision needs two or more options, each with what it means, "
                            "and a recommendation")
        if not it["decision"] and it["steps"] < 1:
            problems.append(f"{where}: an operator action needs numbered steps in plain English — "
                            "the URL to open, what to click, the exact command, what they should see")
    return problems


def cmd_lint(a):
    path = todo_path(a.file)
    problems = lint_page(path)
    if problems is None:
        sys.stderr.write(f"df-operator-todo: no page at {path} — missing is not clean.\n")
        return 2
    if not problems:
        print(f"operator-todo: clean — only open items, in shape -> {path}")
        return 0
    print(f"operator-todo: {len(problems)} problem(s) in {path}")
    for p in problems:
        print("  - " + p)
    print("Rewrite each item with `df-operator-todo add` (same --id replaces it); delete what is "
          "closed. History belongs in git and NOTES.md, never on this page.")
    return 1


# ───────────────────────────────────────────────────────────────────────────────────────────────
# PUBLISH — the page the operator actually reads, at ONE stable URL.
#
# Operator ruling 2026-10-30, in his words: "please create one engram html accessible via a public
# link, with all the things you need from me: decisions and actions. Decisions have to be short,
# with context in plain english. Actions have to have details step by step and what to click,
# always full links and full pathnames, so I don't have to ask 'what repo, what app'. Only keep
# open issues, remove all done … Every time you update things and write me a message, you update
# the same file. I'll pin it to this channel … If you need something from me, it has to be in this
# file. If something is done, it has to be removed."
#
# WHY A TOOL AND NOT A HABIT. The page already existed as markdown at the notepad root, and he
# could not read it: it is in a private repo on a machine he is not at. The content was right and
# the SURFACE was wrong. Everything below is the surface, and every part of it is enforced rather
# than remembered, because "remember to re-publish before you message him" is exactly the promise
# a session breaks on its fourteenth turn.
#
#  1. ONE PAGE, UPDATED IN PLACE. `engram_write` mints a NEW object every call, so publishing with
#     it hands him a new URL per update and his pin rots silently. `engram_update` keeps the id,
#     and MEASURED 2026-10-30 before any of this was written: it preserves `format: "html"` (read
#     back at doc_version 2, new body, same id). The id is recorded at the first publish in
#     <notepad>/.df/operator-page.json and reused for ever.
#     ⛔ NEVER `write` A PAGE THAT ALREADY HAS AN ID. That is the one failure this cannot survive:
#     the operator keeps reading a pinned page that no longer moves, while the agent reports
#     success every time.
#  2. THE URL CANNOT BE DERIVED, SO IT IS CONFIGURED. Neither call returns one; the render route is
#     <base>/<object id>, and the base carries an estate's library and namespace ids. ⛔ Tier 1 is
#     PUBLIC: nothing estate-specific is hardcoded here, the same rule df-engram follows for the
#     hub, and the publish gate's P4 check exists because "just a default" is how an identifier
#     reaches a public repo. It comes from DF_ENGRAM_PAGES_URL + DF_ENGRAM_PAGES_NS, set per
#     machine in the Tier-3 record. Both unset ⇒ publishing is NOT CONFIGURED and `--check`
#     PASSES. A feature that refuses without its dependency is right; one that stops every notepad
#     in the fleet from ending a turn is not.
#  3. STALE IS A DEFECT A MACHINE CAN SEE. `publish --check` compares the rendered page's digest
#     with the one recorded at the last publish, so "I updated the page" and "I told him I updated
#     the page" stop being the same sentence. The Stop gate runs it.
#     ⚠️ THE DIGEST COVERS THE RENDER, NOT operator-todo.md, AND DELIBERATELY EXCLUDES THE
#     TIMESTAMP — a digest over the whole document would differ on every render and report every
#     page as stale for ever, which is a check that cannot pass. RENDERER is in the digest, so
#     changing this renderer correctly marks every published page stale: it IS out of date.
#
# ⚠️ 25 KB IS A REAL CEILING, NOT A STYLE BUDGET — the public route truncates a larger page, and a
# truncated queue silently loses its last items. `publish` REFUSES over the cap and names the
# biggest items, because the alternative is a page that looks complete and is not.
# What Engram is, and how a machine is authorised to reach it: [Engram](../../../starter-kit/instance/AUTHENTICATION.md#engram)
RENDERER = "1"
PAGE_STATE_REL = os.path.join(".df", "operator-page.json")
PAGES_NS_VAR = "DF_ENGRAM_PAGES_NS"
PAGES_URL_VAR = "DF_ENGRAM_PAGES_URL"
AGENT_VAR = "DF_AGENT_ID"
CHANNEL_VAR = "DF_OPERATOR_CHANNEL"
OPERATOR_VAR = "DF_OPERATOR_NAME"
SIZE_CAP = 25000
URL_RE = re.compile(r"https?://[^\s<>\"')\]]+")
RUN_RE = re.compile(r"(?i)\b(?:then )?run\s*:\s*(\S.*)$")
# The same command, written as "<prose>: <command>" rather than "Run: <command>".
CMD_RE = re.compile(r"(?:(?<=: )|(?<=^))((?:bash|git|cd|claude|coder|df-[a-z-]+|gh|curl|python3|unzip|npm)\s+\S[^`]*)$")
LETTER_RE = re.compile(r"^([A-Z])\b")

CSS = (
    ":root{--bg:#fbfaf7;--fg:#1d1d1b;--muted:#6b6a64;--card:#fff;--line:#e4e1d8;"
    "--accent:#8a4b0f;--code:#f1eee6;--stop:#a3321c}"
    "@media (prefers-color-scheme:dark){:root{--bg:#161614;--fg:#ecebe6;--muted:#a3a29b;"
    "--card:#1f1f1c;--line:#34332e;--accent:#e0a35c;--code:#2a2925;--stop:#e2795e}}"
    "body{background:var(--bg);color:var(--fg);font:15px/1.55 system-ui,-apple-system,"
    "Segoe UI,sans-serif;margin:0;padding:24px 16px}"
    "main{max-width:860px;margin:0 auto}"
    "h1{font-size:22px;margin:0 0 4px}"
    "h2{font-size:17px;margin:28px 0 10px;border-bottom:1px solid var(--line);padding-bottom:4px}"
    "h3{font-size:16px;margin:0 0 8px;line-height:1.4}"
    ".meta{color:var(--muted);font-size:13px;margin:0}"
    ".card{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--accent);"
    "border-radius:6px;padding:12px 14px;margin:10px 0}"
    ".card.stop{border-left-color:var(--stop)}"
    ".lab{display:inline-block;background:var(--accent);color:var(--bg);border-radius:4px;"
    "padding:1px 6px;font:600 13px/1.5 ui-monospace,monospace;margin-right:6px;"
    "vertical-align:1px}"
    ".card.stop .lab{background:var(--stop)}"
    "p{margin:8px 0}"
    "ul,ol{margin:8px 0;padding-left:22px}"
    "li{margin:4px 0}"
    ".opt{list-style:none;padding-left:0}"
    ".opt li{border-left:2px solid var(--line);padding-left:10px}"
    ".opt li.rec{border-left-color:var(--accent)}"
    ".rec{margin:8px 0}"
    ".foot{color:var(--muted);font-size:13px;border-top:1px solid var(--line);padding-top:7px;"
    "margin-bottom:0}"
    "code{background:var(--code);padding:1px 4px;border-radius:4px;"
    "font:13px/1.5 ui-monospace,monospace;word-break:break-all}"
    "a{color:var(--accent);word-break:break-all}"
)


def _esc(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
             .replace('"', "&quot;"))


def _rich(s):
    """Escape FIRST, then re-admit exactly three marks the page uses: `code`, **bold**, and a full
    URL as a link. Nothing else is interpreted — this renders an operator's queue onto a PUBLIC
    page, and a renderer that passes markup through is how a repo name becomes a script tag."""
    out = _esc(s)
    out = re.sub(r"`([^`]+)`", r"<code>\1</code>", out)
    out = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", out)
    return URL_RE.sub(lambda m: '<a href="%s">%s</a>' % (m.group(0), m.group(0)), out)


def _step_html(s):
    """A step's command gets monospaced so he can see where the prose stops and the command
    starts — written as `Run: <cmd>` or as `<prose>: <cmd>`, and only up to an em-dash, because
    the tail after one is always what he should SEE, never part of what he types."""
    if "`" not in s:
        m = RUN_RE.search(s) or CMD_RE.search(s)
        if m:
            cmd, tail = m.group(1).rstrip(), ""
            for sep in (" — ", " -- "):
                if sep in cmd:
                    cmd, rest = cmd.split(sep, 1)
                    tail = sep + rest
                    break
            s = s[:m.start(1)] + "`" + cmd.rstrip() + "`" + tail
    return _rich(s)


def split_rest(rest):
    """Decompose one entry line back into the fields `add` composed it from. This is that
    function's inverse over the tool's OWN separators, not a guess at free text."""
    out = {"task": rest, "category": "", "why": "", "do": "", "ref": "", "raised": ""}
    m = RAISED_RE.search(rest)
    if m:
        out["raised"] = m.group(1)
        rest = rest[:m.start()]
    for key, mark in (("ref", " · _ref:_ "), ("do", " · _do:_ ")):
        i = rest.rfind(mark)
        if i >= 0:
            out[key] = rest[i + len(mark):].strip()
            rest = rest[:i]
    m = re.match(r"^\*\*(.*?)\*\* · _yours because:_ \*\*([a-z]+)\*\* — (.*)$", rest)
    if m:
        out["task"], out["category"], out["why"] = m.group(1), m.group(2), m.group(3).strip()
    else:
        out["task"] = rest
    return out


def _parts(extra):
    ctx = [l[len(CONTEXT_P):] for l in extra if l.startswith(CONTEXT_P)]
    opts = [l[len(OPTION_P):] for l in extra if l.startswith(OPTION_P)]
    rec = [l[len(RECOMMEND_P):] for l in extra if l.startswith(RECOMMEND_P)]
    steps = [re.sub(r"^\s*\d+\.\s*", "", l) for l in extra if STEP_RE.match(l)]
    return ctx, opts, rec, steps


def _card(label, blocking, fields, ctx, opts, rec, steps):
    cls = "card stop" if blocking else "card"
    h = ['<section class="%s" id="%s">' % (cls, label)]
    h.append('<h3><span class="lab">%s</span>%s</h3>' % (label, _rich(fields["task"])))
    for c in ctx:
        h.append("<p>%s</p>" % _rich(c))
    if opts:
        pick = ""
        if rec:
            m = LETTER_RE.match(rec[0].strip())
            pick = m.group(1) if m else ""
        h.append('<ul class="opt">')
        for o in opts:
            m = LETTER_RE.match(o.strip())
            mine = bool(pick) and bool(m) and m.group(1) == pick
            h.append('<li class="rec">%s</li>' % _rich(o) if mine else "<li>%s</li>" % _rich(o))
        h.append("</ul>")
    for r in rec:
        h.append('<p class="rec"><strong>My recommendation:</strong> %s</p>' % _rich(r))
    if steps:
        h.append("<ol>")
        for s in steps:
            h.append("<li>%s</li>" % _step_html(s))
        h.append("</ol>")
    foot = []
    if blocking:
        foot.append("<strong>Blocking — the loop is stopped until this is done.</strong>")
    if fields["category"]:
        foot.append("Yours because (<strong>%s</strong>): %s"
                    % (_esc(fields["category"]), _rich(fields["why"])))
    if fields["do"] and not steps:
        foot.append("How to answer: %s" % _rich(fields["do"]))
    if fields["ref"]:
        foot.append(_rich(fields["ref"]))
    if fields["raised"]:
        foot.append("waiting since %s" % _esc(fields["raised"]))
    h.append('<p class="foot">%s</p>' % " · ".join(foot))
    h.append("</section>")
    return "\n".join(h)


def render_body(blocking, async_):
    """The page, minus its <head> and its timestamp: deterministic, so it can be hashed.

    ⚠️ ORDER IS NOT COSMETIC. Decisions first, because an unanswered decision is usually what
    blocks the actions; within each group, BLOCKING first. A queue sorted by when it was raised
    teaches the reader to scroll."""
    rows = [(True, i, r, x) for i, r, x in blocking] + [(False, i, r, x) for i, r, x in async_]
    dec, act = [], []
    for blk, iid, rest, extra in rows:
        f = split_rest(rest)
        (dec if f["category"] == "decision" else act).append((blk, iid, f, extra))
    dec.sort(key=lambda t: not t[0])
    act.sort(key=lambda t: not t[0])
    out = []
    for kind, group in (("D", dec), ("A", act)):
        if not group:
            continue
        out.append("<h2>%s</h2>" % ("Decisions — I need your call"
                                    if kind == "D" else "Actions — only you can do these"))
        for n, (blk, iid, f, extra) in enumerate(group, 1):
            ctx, opts, rec, steps = _parts(extra)
            out.append(_card("%s%d" % (kind, n), blk, f, ctx, opts, rec, steps))
    if not out:
        out.append("<h2>Nothing is waiting on you</h2><p>Every open item has a path that does not "
                   "need you. This page is rewritten whenever that changes.</p>")
    return "\n".join(out), len(dec), len(act)


def _channel_link():
    ch = os.environ.get(CHANNEL_VAR, "").strip()
    if not ch:
        return ""
    if ch.startswith("http"):
        return '<a href="%s">your channel</a>' % _esc(ch)
    return '<a href="https://slack.com/app_redirect?channel=%s">%s</a>' % (_esc(ch), _esc(ch))


def agent_id(path):
    return os.environ.get(AGENT_VAR) or os.path.basename(os.path.dirname(os.path.abspath(path)))


def page_title(path):
    """⚠️ STABLE ACROSS UPDATES, AND DF_OPERATOR_NAME IS PART OF IT. It is the object's
    title and the heading the operator recognises in a pin, and it is what a FIRST publish
    looks for in the object store — so changing either variable on a machine that has no
    state file yet would mint a SECOND page at a SECOND link.
    Deriving it from anything that moves (an item count, a date) renames the page every
    turn."""
    # ⛔ NO REAL NAME HERE. Tier 1 is public and generic; the operator's name is a
    # Tier-3 fact (DF_OPERATOR_NAME), like the hub and the namespace. The publish gate
    # caught the first version of this line, which defaulted to a real one.
    return "%s: what I need from %s" % (agent_id(path),
                                        os.environ.get(OPERATOR_VAR, "the operator"))


def render_page(path, now):
    body, nd, na = render_body(*parse(path))
    digest = hashlib.sha256(("%s\0%s" % (RENDERER, body)).encode("utf-8")).hexdigest()
    title = page_title(path)
    chan = _channel_link()
    line = [_esc(agent_id(path))]
    if chan:
        line.append(chan)
    line.append("Updated %s" % now.strftime("%Y-%m-%d %H:%M UTC"))
    line.append("%d decision%s, %d action%s"
                % (nd, "" if nd == 1 else "s", na, "" if na == 1 else "s"))
    html = (
        "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        "<title>%s</title>\n<style>\n%s\n</style>\n</head>\n<body>\n<main>\n"
        "<h1>%s</h1>\n<p class=\"meta\">%s</p>\n%s\n"
        "<p class=\"meta\" style=\"margin-top:26px\">Answer in your channel with the label — for "
        "example <code>D2: A</code>, or <code>A3 done</code>. Only open items are here: anything "
        "answered or finished is removed, and the history lives in GitHub and Notion. "
        "Page digest <code>%s</code>.</p>\n</main>\n</body>\n</html>\n"
        % (_esc(title), CSS, _esc(title), " · ".join(line), body, digest[:12]))
    return html, digest, nd, na


def page_state_path(todo):
    return os.path.join(os.path.dirname(os.path.abspath(todo)), PAGE_STATE_REL)


def read_page_state(todo):
    try:
        with open(page_state_path(todo), encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def write_page_state(todo, state):
    p = page_state_path(todo)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2, sort_keys=True)
        f.write("\n")


def _engram_bin():
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "df-engram")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("df-engram")


UNPUBLISHED = (
    "operator-todo: %d open item(s) and this page has NEVER been published.\n"
    "He cannot read a markdown file in a private repo on a machine he is not at. Publish it:\n"
    "  df-operator-todo publish\n"
    "then end your message to him with the link it prints.")
STALE = (
    "operator-todo: the page he reads is OUT OF DATE (published digest %s, current %s).\n"
    "Items changed since the last publish, so his pinned link shows a queue that is no longer "
    "true — and he answers from what he can see.\n"
    "  df-operator-todo publish\n"
    "then end your message to him with the link.")


def cmd_publish(a):
    path = todo_path(a.file)
    problems = lint_page(path)
    if problems is None:
        return _refuse("no page at %s. Run `df-operator-todo init` first." % path)
    now = datetime.now(timezone.utc)
    html, digest, nd, na = render_page(path, now)
    state = read_page_state(path)
    ns = os.environ.get(PAGES_NS_VAR, "").strip()
    base = os.environ.get(PAGES_URL_VAR, "").strip().rstrip("/")

    if a.check:
        # ⚠️ Not configured is not a defect. A machine with no pages namespace has nothing to keep
        # current, and a gate that refuses there would stop every turn on every notepad that never
        # opted in.
        if not ns or not base:
            print("operator-todo: publishing is not configured here (%s / %s unset) — nothing to "
                  "keep current." % (PAGES_NS_VAR, PAGES_URL_VAR))
            return 0
        if not state.get("object_id"):
            if nd + na == 0:
                print("operator-todo: nothing open and nothing published — consistent.")
                return 0
            print(UNPUBLISHED % (nd + na))
            return 1
        if state.get("digest") != digest:
            print(STALE % (str(state.get("digest"))[:12], digest[:12]))
            return 1
        print("operator-todo: the published page is current (%d decision(s), %d action(s)) -> %s"
              % (nd, na, state.get("url", "?")))
        return 0

    if problems:
        return _refuse(
            "%d lint problem(s) on %s. The page he reads is rendered FROM this file, so every "
            "defect here is published to a public URL. Run `df-operator-todo lint`, fix, then "
            "publish." % (len(problems), path))
    if a.out:
        with open(a.out, "w", encoding="utf-8") as f:
            f.write(html)
        print("operator-todo: rendered %d bytes -> %s" % (len(html.encode("utf-8")), a.out))
    size = len(html.encode("utf-8"))
    if size > SIZE_CAP:
        rows = []
        for i, r, x in parse(path)[0] + parse(path)[1]:
            rows.append((len(r) + sum(len(e) for e in x), i))
        rows.sort(reverse=True)
        return _refuse(
            "the rendered page is %d bytes and the cap is %d — the public route truncates a "
            "larger page, which loses the END of your queue without saying so.\nBiggest items: "
            "%s.\nClose what is done, or shorten their --context/--step text."
            % (size, SIZE_CAP, ", ".join("%s (%d)" % (i, n) for n, i in rows[:4])))
    if a.dry_run:
        print("operator-todo: DRY RUN — %d bytes, digest %s, %d decision(s), %d action(s). "
              "Nothing published." % (size, digest[:12], nd, na))
        return 0
    if not ns or not base:
        return _refuse(
            "publishing is not configured on this machine. Set both, per machine, in the Tier-3 "
            "record's settings.env (never in Tier 1 — it is public and these carry estate ids):\n"
            "  %s=<the namespace that holds shared pages>\n"
            "  %s=<the public render base, ending in the namespace id>\n"
            "Then: df-operator-todo publish" % (PAGES_NS_VAR, PAGES_URL_VAR))
    tool = _engram_bin()
    if not tool:
        return _refuse("df-engram is not on PATH and is not beside this script; it owns the hub "
                       "transport. Install the kit, or run `df-operator-todo publish --out <file>` "
                       "and publish that file yourself.")
    tmp = os.path.join(os.environ.get("TMPDIR", "/tmp"), "df-operator-page.html")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(html)
    # --notepad is EXPLICIT because df-engram otherwise walks up from CWD for NOTES.md, and a
    # publish is not run from a notepad every time: a Stop hook fires wherever the session
    # happens to be. Measured as a rc-2 refusal from a repo root, by the suite.
    cmd = [tool, "--notepad", os.path.dirname(os.path.abspath(path)),
           "page", "--ns", ns, "--title", page_title(path), "--html", tmp]
    if state.get("object_id"):
        cmd += ["--id", state["object_id"]]
    else:
        cmd += ["--visibility", a.visibility]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        return _refuse("df-engram page failed; NOTHING was recorded, so the next publish retries "
                       "the same object. Fix the hub or the credential and run it again.")
    try:
        res = json.loads(r.stdout.strip().split("\n")[-1])
    except Exception:
        sys.stderr.write(r.stdout + r.stderr)
        return _refuse("df-engram page did not return JSON; not recording an id I cannot read.")
    oid = res.get("object_id")
    if not oid:
        return _refuse("df-engram page returned no object_id: " + r.stdout.strip()[:200])
    url = "%s/%s" % (base, oid)
    write_page_state(path, {"object_id": oid, "url": url, "digest": digest, "renderer": RENDERER,
                            "published": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
                            "items": nd + na, "title": page_title(path),
                            "bytes": size})
    print("operator-todo: %s %d decision(s) and %d action(s) -> %s"
          % ("updated" if res.get("updated") else "published", nd, na, url))
    print("End your message to him with that link. It never changes.")
    return 0


def main():
    p = argparse.ArgumentParser(prog="df-operator-todo", description=__doc__.split("\n")[0])
    p.add_argument("--file", help="explicit path (tests); default is <notepad>/" + FILENAME)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="record or update one task the operator owes")
    a.add_argument("--id", required=True)
    a.add_argument("--task", required=True)
    a.add_argument("--category", required=True, choices=sorted(CATEGORIES),
                   help="the operator-only thing this needs; if none fits, the item is YOURS")
    a.add_argument("--why", required=True, help="why that category applies, in this case")
    a.add_argument("--context", required=True,
                   help="REQUIRED, plain English, no jargon: what this is about, and what breaks "
                        "or stays broken until it is decided")
    a.add_argument("--do", dest="do", help="decision: how to answer; action: an optional one-line summary")
    a.add_argument("--step", action="append",
                   help="action items, 1+ in order: one plain-English step each — the URL to open, "
                        "what to click, the exact command, what they should see")
    a.add_argument("--ref")
    a.add_argument("--option", action="append",
                   help="decision only, 2+: \"<choice>: <what it means and what follows>\"")
    a.add_argument("--recommend", help="decision only: which option, and why")
    a.add_argument("--blocking", action="store_true")
    a.set_defaults(func=cmd_add)

    li = sub.add_parser("lint", help="check the page holds only open items, in shape")
    li.set_defaults(func=cmd_lint)

    pb = sub.add_parser("publish", help="update the ONE HTML page the operator reads, in place")
    pb.add_argument("--check", action="store_true",
                    help="exit 1 if the published page is older than this file (the Stop gate "
                         "runs this); 0 when publishing is not configured here")
    pb.add_argument("--dry-run", action="store_true", help="render and report; publish nothing")
    pb.add_argument("--out", help="also write the rendered HTML here (inspection, tests)")
    pb.add_argument("--visibility", default="public", choices=["public", "private", "inherit"],
                    help="FIRST publish only: how the object is served. Default public — the "
                         "operator asked for a link he can open. Later publishes never change it.")
    pb.set_defaults(func=cmd_publish)

    d = sub.add_parser("done", help="remove a finished task (no history kept in the file)")
    d.add_argument("--id", required=True)
    d.add_argument("--verified", help="the evidence you saw that it is done")
    d.add_argument("--by-operator", action="store_true", help="the operator said it is done")
    d.set_defaults(func=cmd_done)

    l = sub.add_parser("list", help="print the open queue")
    l.add_argument("--blocking-only", action="store_true")
    l.set_defaults(func=cmd_list)

    i = sub.add_parser("init", help="create the empty page at the notepad root if it is absent")
    i.set_defaults(func=cmd_init)

    pa = sub.add_parser("path", help="print where the file resolves for this cwd")
    pa.set_defaults(func=lambda x: (print(todo_path(x.file)), 0)[1])

    args = p.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
