#!/usr/bin/env bash
# df-worker — the ONE launcher for a single-shot headless worker.
#
#   df-worker <role> <item-id> "<promise>" [--repo <path>] [--notepad <path>]
#             [--rules <file>]... [--deny "<rule>"]... [--disallow-tool <name>]... [--dry-run]
#
# WHAT THIS IS. A worker is an untrusted promiser: it resolves ONE tracker item and exits.
# It does not loop, does not chart a map, does not dispatch further workers. A LOOP over
# many iterations of one mission is a different job and stays in df-supervisor.sh; this is
# the single shot. What collapses into this file is the LAUNCH CONTRACT the two disagreed
# on — settings scope, MCP shape, permission mode, budget, and what the child can reach.
#
# ── THE MEASUREMENT THIS FILE IS BUILT ON ───────────────────────────────────────────────
# A plugin's hooks, bin/ and agents reach a headless child on exactly ONE delivery path:
# the `--plugin-dir` COMMAND-LINE FLAG. Measured, not inferred:
#
#   * `--plugin-dir <root>` + `-p`                      -> hooks fire, bin is on PATH
#   * `--plugin-dir <root>` + `-p --setting-sources project` -> same, and this is the cell
#     that was at risk: a plugin Stop hook genuinely BLOCKED a headless turn from a cwd
#     with no `.claude` directory at all.
#   * a project `.claude/settings.json` declaring `enabledPlugins` (+ extraKnownMarketplaces)
#     -> delivers NOTHING headlessly. Not the hooks, not bin, not the agent, not a monitor.
#     And it fails SILENTLY: stdout carries no warning, stderr is 0 bytes, `--debug` adds
#     0 bytes. A worker on that path cannot tell it is ungoverned.
#
# So `--plugin-dir` is passed ALWAYS, from this script's own location, and it is not
# optional or configurable: `--setting-sources` cannot exclude a command-line flag, which
# is precisely why this path survives the narrow settings scope. Docs, cli-reference:
# "--plugin-dir  Load a plugin from a directory or `.zip` archive for this session only.
# Each flag takes one path."  and  "--setting-sources  Comma-separated list of setting
# sources to load (`user`, `project`, `local`)".
#
# ⚠️ NEVER put an `agent` key in the plugin's settings.json. Measured: a plugin
# settings.json `{"agent": ...}` HIJACKS the main thread of a headless run — the worker
# becomes that agent, never calls the tool it was asked to call, and still exits 0 with
# is_error false. It is invisible from the outside.
#
# ── SIDE EFFECT, DELIBERATE: the compound-Bash gate stops loading ───────────────────────
# `--setting-sources project` loads only project-scoped settings, so USER-level hooks are
# not loaded in the child. The compound-Bash gate is one of them. It is an operator-
# ergonomics gate (it keeps an interactive transcript reviewable), not a governance gate —
# nothing about correctness, safety or evidence depends on it — and it has cost real
# workers blocked tool calls. Under this launch contract it simply stops loading, and that
# is the correct outcome arrived at deliberately rather than by accident. The hooks that DO
# matter headlessly must therefore live in the PLUGIN's hooks.json, never at user level.
#
# ── WHAT THE WORKER CAN REACH ───────────────────────────────────────────────────────────
# The scratch dir is the child's cwd and carries its own `.claude/settings.json`, so
# `--setting-sources project` resolves THERE. `--add-dir` names the scratch and (when
# given) the target repo — and NEVER the notepad root. The notepad holds the mission's
# holdout cases; the worker's inability to read them is a property of the sandbox, not of
# its good behaviour. What the worker legitimately needs from the notepad is COPIED in by
# this launcher (copied, so the copy can be redacted; not linked, so the tree cannot be
# walked out of).
#
# ── MCP: ALLOW-LIST, AND REFUSE IF IT CANNOT BE BUILT ───────────────────────────────────
# `--setting-sources project` also removes every MCP server, because MCP is configured at
# USER scope. They are handed back EXPLICITLY and scoped to one profile's hub with
# `--mcp-config <file> --strict-mcp-config`. A deny-list is open by default (the next hub
# added defeats it silently); an allow-list fails closed. If the profile cannot be built we
# REFUSE TO LAUNCH: a worker with no tracker cannot report that it has none, so the failure
# would be silent by construction — which is the exact shape of bug this estate keeps
# paying for.
# The config goes in a private mktemp dir, never under the notepad: it can hold LITERAL
# bearer tokens, and mcp-profile-config.py refuses to write inside a git work tree for that
# reason. This is the matching half of that refusal.
#
# ⚠️ T1-C/D/E, MEASURED ON TWO MACHINES 2026-09-09: the profile resolution used to fall
# through to the LITERAL "default" and never the resolved record's own `defaultProfile`; the
# instance root used to be derived ONLY from df-mission's realpath, landing on a vendored
# engine's dir (which holds no lockfile) with no fallback; and the scratch dir used to be
# created BEFORE the MCP refusal, so every refused launch left a tree behind. All three are
# fixed below, in the order the launch actually needs them: instance root, then profile,
# then the MCP allow-list (which may refuse), and ONLY THEN the scratch dir.
#
# Env:
#   WORKER_PERMISSION_MODE  default bypassPermissions (a hardcoded bypass is a guarantee
#                           you cannot lower; this is the default value, not the only one)
#   WORKER_MAX_BUDGET_USD   default 100 — a RUNAWAY BACKSTOP, not a cost control
#   WORKER_MODEL            model alias; the tier is a launch-profile decision, so no model
#                           name is ever hardcoded in this file
#   WORKER_MISSION          mission id override (otherwise resolved from the notepad state)
#   WORKER_MCP_PROFILE      MCP profile name (otherwise the mission's `profile` file, then
#                           the resolved record's `defaultProfile`, then "default")
#   WORKER_MCP_SOURCE       source MCP config to scope (default ~/.claude.json)
#   WORKER_DRY_RUN=1        same as --dry-run
#   LOOM_LOCK               instance lockfile path. When set and the file exists, it names
#                           BOTH the instance root (its kit root, computed the same way
#                           mcp-profile-config.py's own kit_root_of() does) and the record
#                           `defaultProfile` is read from, ahead of every other source; it is
#                           also passed through to mcp-profile-config.py as --lock.
set -uo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "$SELF/.." && pwd)"
# The plugin ships inside the Tier-1 tree, so the engine is two levels up from the plugin
# root — true both in a Tier-1 checkout and in a vendored copy at <kit>/vendor/dark-factory.
KIT_ROOT="$(cd "$PLUGIN_ROOT/../.." && pwd)"
MCP_TOOL="${MCP_PROFILE_CONFIG:-$KIT_ROOT/boot-kit/scripts/mcp-profile-config.py}"
# ⚠️ THE INSTALLED LAYOUT IS A THIRD SHAPE. Measured on the first laptop install (2026-09-05):
# install.plugins[] materialises this plugin under ~/.claude/skills/df-governed, so KIT_ROOT
# above is ~/.claude and there is no boot-kit/ there — the engine is materialised into the
# INSTANCE repo's boot-kit/scripts/, wherever that repo lives. The one thing the installer
# guarantees about that directory is that rehydrate.sh links df-mission from it onto PATH.
# So the engine dir is: where df-mission really lives. Resolved through the symlink with
# python3 (readlink -f is not portable to macOS).
# ⚠️ AND THE VENDORED LAYOUT IS A FOURTH. Measured 2026-09-06, first connector-mode dispatch
# through a kit's vendored Tier-2 shim: this file ran from <kit>/vendor/dark-factory/plugins/
# df-governed/, so KIT_ROOT was <kit>/vendor/dark-factory, its boot-kit/scripts/mcp-profile-
# config.py EXISTED (the vendored Tier 1), the fallback below never fired -- and that copy
# looked for the machine lockfile two levels above ITSELF: vendor/dark-factory, which holds
# none. mcp.profiles silently read as undeclared and the prefix rule took over. The lockfile
# lives in the INSTANCE, and the one thing every layout shares is df-mission on PATH linked
# from the instance's engine dir, so the instance root is derived from that and handed to
# mcp-profile-config as --kit-root whenever it resolves. Which COPY of the tool runs still
# follows the rule above; WHERE it looks for the lockfile no longer depends on it.
#
# ⚠️ T1-D, MEASURED ON TWO MACHINES 2026-09-09: on a kit that VENDORS the engine, the
# df-mission-realpath derivation above lands on <kit>/vendor/dark-factory -- a directory
# with no lockfile of its own, so the other-estates deny-list union scans a root with no
# mcp.profiles and the T1 #152 security fix is silently defeated. `LOOM_LOCK` (the path of
# the record describing THIS machine) is checked FIRST, below, and its kit root computed
# the same way mcp-profile-config.py's own kit_root_of() does. When it is not set, the
# df-mission derivation is still tried, but now WALKS UP from the derived directory until
# it finds one that actually holds a `*.lock.json` or an `instances/` dir (a vendored
# engine sits at <kit>/vendor/dark-factory/boot-kit/scripts; two levels up is
# <kit>/vendor/dark-factory, which has none; four levels up is <kit>, which does). The walk
# never crosses $HOME or / unnoticed -- if nothing is found by then, INSTANCE_ROOT is left
# empty exactly as before this fix.
INSTANCE_ROOT=""
INSTANCE_ROOT_VIA=""
LOOM_LOCK_RESOLVED=0

_kit_root_of() {  # $1 = lockfile path -> the kit root it lives in (mirrors mcp-profile-
                   # config.py's own kit_root_of(): the file's own directory, or three
                   # levels up when the file is <kit>/instances/<name>/loom.lock.json)
  python3 -c '
import os, sys
p = os.path.abspath(sys.argv[1])
d = os.path.dirname(p)
if os.path.basename(os.path.dirname(d)) == "instances":
    print(os.path.dirname(os.path.dirname(d)))
else:
    print(d)
' "$1"
}

_has_record() {  # $1 = directory -> true if it holds a *.lock.json or an instances/ dir
  local _f
  [ -d "$1" ] || return 1
  for _f in "$1"/*.lock.json; do
    [ -e "$_f" ] && return 0
    break
  done
  [ -d "$1/instances" ] && return 0
  return 1
}

if [ -n "${LOOM_LOCK:-}" ] && [ -f "$LOOM_LOCK" ]; then
  INSTANCE_ROOT="$(_kit_root_of "$LOOM_LOCK")"
  INSTANCE_ROOT_VIA="LOOM_LOCK"
  LOOM_LOCK_RESOLVED=1
fi

_dm="$(command -v df-mission 2>/dev/null || true)"
if [ -n "$_dm" ]; then
  _eng="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$_dm" 2>/dev/null || true)"
  if [ -n "$_eng" ]; then
    if [ ! -f "$MCP_TOOL" ] && [ -f "$_eng/mcp-profile-config.py" ]; then
      MCP_TOOL="$_eng/mcp-profile-config.py"
    fi
    if [ -z "$INSTANCE_ROOT" ]; then
      _cand="$(cd "$_eng/../.." 2>/dev/null && pwd || true)"
      if [ -n "$_cand" ]; then
        _walk="$_cand"
        while [ -n "$_walk" ] && ! _has_record "$_walk"; do
          if [ "$_walk" = "/" ] || [ "$_walk" = "$HOME" ]; then
            _walk=""
            break
          fi
          _walk="$(dirname "$_walk")"
        done
        if [ -n "$_walk" ]; then
          INSTANCE_ROOT="$_walk"
          INSTANCE_ROOT_VIA="df-mission"
        fi
      fi
    fi
  fi
fi

[ -n "$INSTANCE_ROOT" ] && printf 'instance-root: %s (via %s)\n' "$INSTANCE_ROOT" "$INSTANCE_ROOT_VIA" >&2

die() { printf 'df-worker: %s\n' "$1" >&2; exit 2; }

ROLE=""; TICKET=""; PROMISE=""; REPO=""; NOTEPAD=""
RULES_LIST=""
DENY_LIST=""
DISALLOW_LIST=""
CLAIM_COLUMNS=""
CLAIM_TOOL=""
CLAIM_ITEM_KEYS=""
CLAIM_VALUES_KEY=""
CLAIM_VALUES_KEY_SET=0
DRY="${WORKER_DRY_RUN:-0}"

POS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)    [ $# -ge 2 ] || die "--repo needs a path";    REPO="$2";    shift 2 ;;
    --notepad) [ $# -ge 2 ] || die "--notepad needs a path"; NOTEPAD="$2"; shift 2 ;;
    # ── --rules: the LAUNCHER's binding text, verbatim, repeatable ──────────────────────
    # Estate policy (branch rules, deploy and cluster hard stops) is Tier-2 knowledge: it
    # names clusters and branches that a PUBLIC Tier-1 file must never carry. So this
    # launcher does not author it — it TRANSPORTS it, unread and unedited, from whoever
    # launched the worker into the worker's brief and onto its disk.
    # ⛔ A MISSING RULES FILE IS A REFUSAL, NOT A WARNING. Rules that silently fail to load
    # produce a worker that is confidently ungoverned and reports success — the exact
    # shape of failure this whole ticket exists to end. Checked here, at parse time, so
    # the refusal happens before a scratch dir, an MCP config or a child exists.
    --rules)
      [ $# -ge 2 ] || die "--rules needs a path"
      [ -f "$2" ] || die "--rules file not found: $2 — REFUSING to launch. A worker that silently loses its rules is worse than one that never started."
      RULES_LIST="$RULES_LIST$2
"
      shift 2 ;;
    # ── --deny: the same policy, as a MECHANISM ────────────────────────────────────────
    # --rules is text a model reads and may skim. --deny is a permission rule the tool
    # layer enforces whether or not the worker ever reads anything. Each value goes
    # VERBATIM into permissions.deny of the scratch settings.json below; the child runs
    # with `--setting-sources project` from that scratch dir, so the file is loaded.
    # Docs (permissions): rules are written `Bash(git push *)`; "`Bash(git * main)`"
    # matches "`git push origin main`"; "The `:*` suffix is an equivalent way to write a
    # trailing wildcard"; and deny beats allow — "A broad deny rule like `Bash(aws *)`
    # blocks every matching call, including calls that also match a narrower allow rule".
    # Deny rules also "apply when any subcommand matches them, including a command nested
    # inside a subshell, a command substitution, or a control-flow body", and match "past
    # any leading assignment".
    # ⚠️ AND THE DOCS' OWN CAVEAT, CARRIED not buried: "Bash permission patterns that try
    # to constrain command arguments are fragile." A deny on `Bash(git push * main)` does
    # not catch every spelling of the same act (`git push origin HEAD:main`, a push run
    # from a script). These rules RAISE THE FLOOR; they are not a proof of impossibility,
    # which is exactly why --rules travels alongside and says why the floor is there.
    --deny)
      [ $# -ge 2 ] || die "--deny needs a permission rule"
      DENY_LIST="$DENY_LIST$2
"
      shift 2 ;;
    # ── --disallow-tool: passed to the CHILD, not the deny-permission layer ────────────
    # Docs, cli-reference, verbatim:
    #   "--disallowedTools, --disallowed-tools | Deny rules. A bare tool name removes the
    #   matching tools from Claude's context: `"Edit"` removes Edit, `"*"` removes every
    #   tool, and `"mcp__*"` removes every MCP tool. A scoped rule such as `Bash(rm *)`
    #   leaves the tool available and denies only matching calls. ... |
    #   `"Bash(git log *)" "Bash(git diff *)" "Edit"`"
    # One flag, then every value as its own argv word — the docs' own example shows a
    # SINGLE `--disallowedTools` followed by a space-separated list, never the flag
    # repeated once per value.
    --disallow-tool)
      [ $# -ge 2 ] || die "--disallow-tool needs a tool name"
      DISALLOW_LIST="$DISALLOW_LIST$2
"
      shift 2 ;;
    # ── --claim-columns: what counts as THE claim, not just a write to this ticket ────
    # claim-gate.py used to accept ANY change_item_column_values write to DF_TICKET as the
    # claim. Measured on the first live dispatch (2026-09-05): a worker wrote an email
    # address into one text column and left DF Status untouched, and the gate could not
    # tell that apart from a real claim. This value is exported verbatim as
    # DF_CLAIM_COLUMNS — a JSON object of {columnId: expectedValue}, values a string or an
    # object like {"label": "Doing"} — and claim-gate.py then requires a write's
    # columnValues to match every key before treating it as the claim.
    --claim-columns)
      [ $# -ge 2 ] || die "--claim-columns needs a JSON object"
      CLAIM_COLUMNS="$2"
      shift 2 ;;
    # ── --claim-tool / --claim-item-keys / --claim-values-key: the same claim, a ────────
    # different tracker's shape. claim-gate.py used to recognise the claim ONLY as a
    # Monday-shaped tool_name with itemId/columnValues — a Notion or Jira worker can never
    # satisfy that and is denied every tool call for the whole session. These three export
    # DF_CLAIM_TOOL / DF_CLAIM_ITEM_KEYS / DF_CLAIM_VALUES_KEY into the child env EXACTLY
    # the way --claim-columns above exports DF_CLAIM_COLUMNS: verbatim, only when given,
    # and echoed in --dry-run. Each is single-valued (not repeatable like --rules/--deny) —
    # one tracker, one shape, per worker.
    #
    # --claim-values-key is the one exception to "only when given, tracked by non-empty
    # value": the EMPTY STRING is itself a meaningful value to claim-gate.py (match
    # DF_CLAIM_COLUMNS against tool_input itself, for a tracker with no nested values
    # object). So this flag is tracked by whether it was PASSED at all
    # (CLAIM_VALUES_KEY_SET), never by whether its value happens to be non-empty.
    --claim-tool)
      [ $# -ge 2 ] || die "--claim-tool needs a regex"
      CLAIM_TOOL="$2"
      shift 2 ;;
    --claim-item-keys)
      [ $# -ge 2 ] || die "--claim-item-keys needs a comma-separated list of arg names"
      CLAIM_ITEM_KEYS="$2"
      shift 2 ;;
    --claim-values-key)
      [ $# -ge 2 ] || die "--claim-values-key needs a name (the empty string is valid: it means match against tool_input itself)"
      CLAIM_VALUES_KEY="$2"
      CLAIM_VALUES_KEY_SET=1
      shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)
      POS=$((POS + 1))
      case "$POS" in
        1) ROLE="$1" ;;
        2) TICKET="$1" ;;
        3) PROMISE="$1" ;;
        *) die "unexpected argument '$1'" ;;
      esac
      shift ;;
  esac
done

[ -n "$ROLE" ]    || die "missing <role>"
[ -n "$TICKET" ]  || die "missing <item-id> (the tracker item id)"
[ -n "$PROMISE" ] || die "missing <promise> — state the deliverable AND the exact unforgeable evidence"

# A malformed --claim-columns would arm claim-gate.py with a value it can only fail closed
# on — refused here, before a scratch dir or MCP config exists, same as a missing --rules
# file: a worker that silently launched with unusable claim columns is worse than one that
# never started.
if [ -n "$CLAIM_COLUMNS" ]; then
  python3 -c 'import json,sys
obj = json.loads(sys.argv[1])
assert isinstance(obj, dict)' "$CLAIM_COLUMNS" 2>/dev/null \
    || die "--claim-columns is not a JSON object: $CLAIM_COLUMNS"
fi

# ── the notepad: walk up from $PWD, exactly as df-mission and df-preflight do ────────────
if [ -z "$NOTEPAD" ]; then
  _d="$PWD"
  while [ "$_d" != "/" ]; do
    if [ -f "$_d/NOTES.md" ]; then NOTEPAD="$_d"; break; fi
    _d="$(dirname "$_d")"
  done
fi
[ -n "$NOTEPAD" ] || die "no notepad found (no NOTES.md at or above \$PWD); pass --notepad"
[ -d "$NOTEPAD" ] || die "notepad is not a directory: $NOTEPAD"
NOTEPAD="$(cd "$NOTEPAD" && pwd)"

if [ -n "$REPO" ]; then
  [ -d "$REPO" ] || die "--repo is not a directory: $REPO"
  REPO="$(cd "$REPO" && pwd)"
fi

# ── which mission is running ────────────────────────────────────────────────────────────
# Exactly one RUNNING state, or nothing. Two running missions means the scope is ambiguous
# and a guess would attach the worker's evidence to the wrong mission; empty is honest.
MISSION="${WORKER_MISSION:-}"
if [ -z "$MISSION" ]; then
  _n=0; _found=""
  for st in "$NOTEPAD"/.df/missions/*/state; do
    [ -f "$st" ] || continue
    if [ "$(tr -d '[:space:]' < "$st" 2>/dev/null)" = "RUNNING" ]; then
      _n=$((_n + 1))
      _found="$(basename "$(dirname "$st")")"
    fi
  done
  [ "$_n" -eq 1 ] && MISSION="$_found"
fi

# ── profile resolution + MCP allow-list, or refuse ───────────────────────────────────────
# ⚠️ T1-C, MEASURED ON TWO MACHINES 2026-09-09: this used to fall through
# WORKER_MCP_PROFILE, the mission's profile file, then straight to the LITERAL "default" —
# never the resolved record's own `defaultProfile`. A kit whose record says
# `"defaultProfile": "catalyst"` refused every launch with "no MCP config for profile
# 'default'", and the owner had to alias `default` into five records to get a worker up.
# The record's declared default now sits between the mission file and the literal
# fallback, read the same way the instance root already is: from $LOOM_LOCK when set, else
# from the single lockfile directly under $INSTANCE_ROOT.
PROFILE=""
PROFILE_VIA=""
if [ -n "${WORKER_MCP_PROFILE:-}" ]; then
  PROFILE="$WORKER_MCP_PROFILE"
  PROFILE_VIA="WORKER_MCP_PROFILE"
elif [ -n "$MISSION" ] && [ -f "$NOTEPAD/.df/missions/$MISSION/profile" ]; then
  PROFILE="$(tr -d '[:space:]' < "$NOTEPAD/.df/missions/$MISSION/profile")"
  PROFILE_VIA="mission profile file"
else
  _defprof=""
  if [ "$LOOM_LOCK_RESOLVED" = "1" ]; then
    _defprof="$(jq -r '.defaultProfile // empty' "$LOOM_LOCK" 2>/dev/null || true)"
  elif [ -n "$INSTANCE_ROOT" ]; then
    _lockn=0
    _onelock=""
    for _f in "$INSTANCE_ROOT"/*.lock.json; do
      [ -e "$_f" ] || continue
      _lockn=$((_lockn + 1))
      _onelock="$_f"
    done
    if [ "$_lockn" -eq 1 ]; then
      _defprof="$(jq -r '.defaultProfile // empty' "$_onelock" 2>/dev/null || true)"
    fi
  fi
  if [ -n "$_defprof" ]; then
    PROFILE="$_defprof"
    PROFILE_VIA="defaultProfile"
  else
    PROFILE="default"
    PROFILE_VIA="default"
  fi
fi
printf 'profile: %s (via %s)\n' "$PROFILE" "$PROFILE_VIA" >&2

[ -f "$MCP_TOOL" ] || die "mcp-profile-config.py not found at $MCP_TOOL — refusing to launch a worker with no MCP allow-list (a worker with no tracker cannot report that it has none)"

MCPDIR="$(mktemp -d "${TMPDIR:-/tmp}/df-worker.XXXXXX")" || die "mktemp failed"
chmod 700 "$MCPDIR" 2>/dev/null || true
trap 'rm -rf "$MCPDIR"' EXIT
MCP_CFG="$MCPDIR/mcp-$PROFILE.json"

LOOM_LOCK_FOR_MCP=""
[ "$LOOM_LOCK_RESOLVED" = "1" ] && LOOM_LOCK_FOR_MCP="$LOOM_LOCK"

# ── B24: mcp-profile-config.py may answer in one of TWO shapes now ──────────────────────
# `hubs`      — the original shape: it writes $MCP_CFG, and this launcher allow-lists it via
#               --mcp-config/--strict-mcp-config, exactly as before.
# `connector` — a claude.ai CONNECTOR is not a file-based server at all (measured: it
#               appears in NO file, not even ~/.claude.json), so there is nothing to write
#               into a strict config. mcp-profile-config.py instead prints a machine-readable
#               `PLAN {...}` line on STDOUT and writes no file; this launcher reads that line
#               and scopes the connector by DENYING every other server's tools via the
#               existing --disallowedTools mechanism, rather than allow-listing one.
# Stdout is captured (never merged into stderr, unlike before) so the PLAN line can be told
# apart from the WARN/INFO lines mcp-profile-config.py prints on stderr; stderr still flows
# through live, exactly as it did when both fds were merged.
MCP_STDOUT="$(python3 "$MCP_TOOL" --profile "$PROFILE" --out "$MCP_CFG" \
        --config "${WORKER_MCP_SOURCE:-$HOME/.claude.json}" \
        ${INSTANCE_ROOT:+--kit-root "$INSTANCE_ROOT"} \
        ${LOOM_LOCK_FOR_MCP:+--lock "$LOOM_LOCK_FOR_MCP"})"
MCP_RC=$?
MCP_REFUSAL="no MCP config for profile '$PROFILE' — REFUSING to launch. A worker with no tracker cannot report that it has none, so this failure would be silent by construction. Declare mcp.profiles.$PROFILE in the instance lockfile, or run df-preflight --profile $PROFILE which proposes it."
[ "$MCP_RC" -eq 0 ] || die "$MCP_REFUSAL"

MCP_PLAN_LINE="$(printf '%s\n' "$MCP_STDOUT" | grep -m1 '^PLAN ')"
if [ -n "$MCP_PLAN_LINE" ]; then
  MCP_MODE="connector"
  MCP_PLAN_JSON="${MCP_PLAN_LINE#PLAN }"
  MCP_CONNECTOR_NAME="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("name",""))' "$MCP_PLAN_JSON")" \
    || die "$MCP_REFUSAL (PLAN line could not be parsed)"
  # The plan's own disallow entries join the caller's --disallow-tool values in ONE list —
  # same mechanism, same argv shape, so a connector-mode worker's tool denial is asserted
  # exactly like every other --disallow-tool case.
  while IFS= read -r pd; do
    [ -n "$pd" ] && DISALLOW_LIST="$DISALLOW_LIST$pd
"
  done < <(python3 -c '
import json, sys
for d in json.loads(sys.argv[1]).get("disallow", []):
    print(d)
' "$MCP_PLAN_JSON")
elif [ -f "$MCP_CFG" ]; then
  MCP_MODE="hubs"
else
  # mcp-profile-config.py exited 0 but produced NEITHER a config file NOR a PLAN line — the
  # same silent-by-construction shape the original refusal exists to catch, one layer up.
  die "$MCP_REFUSAL (exited 0 but wrote no config and printed no PLAN line)"
fi
export DF_MCP_MODE="$MCP_MODE"

# ── the worker scratch: the child's cwd, and its own project settings scope ─────────────
# ⚠️ T1-E, MEASURED ON TWO MACHINES 2026-09-09: this used to run BEFORE the MCP refusal
# above, so every refused launch left a `workers/<role>/<ticket>-<ts>/` tree behind — with
# .claude/settings.json, MISSION.md and PROMISE.md already written — even though nothing
# was ever going to launch. The scratch dir and its files are now created only once the
# launch is known to be possible. WORKER_DRY_RUN=1 still creates it once launch is possible
# (the dry run's own output names it) — that property is unchanged by this reordering.
TS="$(date -u +%Y%m%dT%H%M%SZ)"
SCRATCH="$NOTEPAD/workers/$ROLE/$TICKET-$TS"
mkdir -p "$SCRATCH/.claude" || die "cannot create scratch dir $SCRATCH"

# `--setting-sources project` resolves against the child's cwd. This file is what it finds:
# an empty hook set, so nothing from any other project scope reaches the worker; plus the
# `--deny` rules, which is what makes this file load-bearing rather than a placeholder.
# Governance arrives via --plugin-dir, which no settings scope can remove.
#
# Written by python3 rather than by string concatenation: a settings file is "strict JSON"
# and a rule containing a quote would otherwise produce a file Claude Code reports as a
# Settings Error — i.e. a worker whose deny rules silently did not load.
printf '%s' "$DENY_LIST" | python3 -c '
import json, sys
rules = [ln for ln in sys.stdin.read().splitlines() if ln.strip()]
json.dump({"hooks": {}, "permissions": {"deny": rules}}, sys.stdout, indent=2)
sys.stdout.write("\n")
' > "$SCRATCH/.claude/settings.json" || die "cannot write the scratch settings.json"

# ── the launcher's rules, VERBATIM ──────────────────────────────────────────────────────
# Concatenated in the order given, never parsed, never reworded. This launcher is public
# Tier-1 method and must not know an estate's branch names or clusters; it carries them.
RULES_TEXT=""
if [ -n "$RULES_LIST" ]; then
  while IFS= read -r rf; do
    [ -n "$rf" ] || continue
    RULES_TEXT="$RULES_TEXT$(cat "$rf")
"
  done <<RULESEOF
$RULES_LIST
RULESEOF
  printf '%s' "$RULES_TEXT" > "$SCRATCH/RULES.md"
fi

{
  printf '# PROMISE — %s / item %s\n\n' "$ROLE" "$TICKET"
  printf 'Mission: %s\n\n' "${MISSION:-(none resolved)}"
  printf '%s\n' "$PROMISE"
} > "$SCRATCH/PROMISE.md"

# ── the frame, COPIED (never linked) ────────────────────────────────────────────────────
# A symlink into the mission dir would let the worker walk back out into the notepad and
# read the holdout. `cp` cannot be followed anywhere.
FRAME=""
if [ -n "$MISSION" ]; then
  MDIR="$NOTEPAD/.df/missions/$MISSION"
  for f in MISSION.md HARD-STOPS.md; do
    if [ -f "$MDIR/$f" ]; then
      cp "$MDIR/$f" "$SCRATCH/$f" || die "cannot copy $MDIR/$f"
      FRAME="$FRAME $f"
    fi
  done
fi

# ── the brief ───────────────────────────────────────────────────────────────────────────
# Compact on purpose. The frame is on disk beside the worker; repeating it here would pay
# for the same bytes twice.
#
# ⚠️ DEVIATION FROM THE TICKET TEXT, DECLARED. The ticket's prompt sketch says to tell the
# worker "the launcher has already claimed the ticket". This launcher does NOT claim: it
# has no tracker credentials of its own (MCP belongs to the child), and the claim is made
# MECHANICAL one layer down instead — claim-gate.py denies every tool call until the claim
# write lands. Telling the worker the claim is already done would be false AND would
# deadlock it against that gate. So the brief states the mechanism as it actually is.
HARDSTOP_LINE="Hard stops: none supplied with this mission frame — if an action looks irreversible or outward-facing, stop and return blocked-with-evidence."
case "$FRAME" in
  *HARD-STOPS.md*) HARDSTOP_LINE="Hard stops: read ./HARD-STOPS.md in this directory FIRST. They are absolute." ;;
esac

# The rules block sits AFTER the promise and BEFORE the evidence contract: a worker reads
# what it must deliver, then the bounds it must deliver inside, then how to prove it.
RULES_BLOCK=""
if [ -n "$RULES_TEXT" ]; then
  RULES_BLOCK="
## Rules from the launcher (binding)
${RULES_TEXT}
Some of these are also enforced at the tool layer as permission deny rules (see
./.claude/settings.json). A blocked command is not a puzzle to route around: it is the
rule. Route-arounds are a hard stop, not a workaround.
"
fi

PROMPT="You are a Dark Factory WORKER. Role: ${ROLE}. Tracker item: ${TICKET}.${MISSION:+ Mission: ${MISSION}.}

PROMISE (the deliverable AND the exact unforgeable evidence you must return):
${PROMISE}

CLAIM — mechanical, not advisory. Your FIRST tool call must be the tracker write that
claims item ${TICKET}. Every other tool call is DENIED until that write lands; the denial
names the tool and the item id. You may never write to any other item's columns.

SCOPE — you resolve exactly ONE item, then stop. Do not chart a map, do not rule anything
out of scope, do not dispatch further agents. If the item is mis-scoped, say so and stop.

WORKSPACE — your cwd is your scratch dir. Write every artefact here.${REPO:+ The repo you were given is ${REPO}; edit only there.}
${HARDSTOP_LINE}
${RULES_BLOCK}
EVIDENCE — raw, never prose. file:line, diffs, exit codes, verbatim command output. Never
\"done\" / \"all passing\" / \"looks correct\": a confident summary is indistinguishable from a
correct one and will be rejected as UNVERIFIED. If you could not obtain the evidence you
were asked for, that is BLOCKED, not done — a skipped check is not a pass.

BEFORE YOU STOP — write the Verification column on the tracker item: the raw evidence
itself, not a summary of it. Then stop."

# ── argv ────────────────────────────────────────────────────────────────────────────────
# The prompt goes on stdin, not in argv, so the dry-run argv below is exactly the launch
# contract and nothing else.
set -- -p
set -- "$@" --plugin-dir "$PLUGIN_ROOT"
set -- "$@" --setting-sources project
set -- "$@" --add-dir "$SCRATCH"
[ -n "$REPO" ] && set -- "$@" --add-dir "$REPO"
# hubs mode allow-lists via --mcp-config/--strict-mcp-config, exactly as before. connector
# mode passes NEITHER flag — a claude.ai connector isn't a file-based server to allow-list,
# so scoping happens entirely through the --disallowedTools list built above.
if [ "$MCP_MODE" = "hubs" ]; then
  set -- "$@" --mcp-config "$MCP_CFG" --strict-mcp-config
fi
if [ -n "$DISALLOW_LIST" ]; then
  set -- "$@" --disallowedTools
  while IFS= read -r dn; do
    [ -n "$dn" ] && set -- "$@" "$dn"
  done <<DISALLOWEOF
$DISALLOW_LIST
DISALLOWEOF
fi
set -- "$@" --permission-mode "${WORKER_PERMISSION_MODE:-bypassPermissions}"
set -- "$@" --max-budget-usd "${WORKER_MAX_BUDGET_USD:-100}"
set -- "$@" --output-format json
[ -n "${WORKER_MODEL:-}" ] && set -- "$@" --model "${WORKER_MODEL}"

# Hooks inherit the parent environment ("A hook process inherits the parent environment"),
# so these are how claim-gate.py knows which item this worker owns — and, by their absence,
# how it stays inert in every session that df-worker did not launch.
export DF_TICKET="$TICKET"
export DF_ROLE="$ROLE"
export DF_MISSION="$MISSION"
# DF_SCRATCH is the one directory that does not move for the worker's whole life — unlike
# the hook event's own cwd, which moves the moment the worker `cd`s into the repo it was
# told to edit. claim-gate.py keys its marker on this when set.
export DF_SCRATCH="$SCRATCH"
# DF_CLAIM_COLUMNS, when given, is what claim-gate.py requires a write to DF_TICKET to
# carry before treating it as the claim — exported only when the caller passed one, so a
# worker launched without --claim-columns is unaffected (old behaviour).
[ -n "$CLAIM_COLUMNS" ] && export DF_CLAIM_COLUMNS="$CLAIM_COLUMNS"
# DF_CLAIM_TOOL / DF_CLAIM_ITEM_KEYS / DF_CLAIM_VALUES_KEY: same rule, a different
# tracker's shape — exported only when the caller passed the matching flag, so a worker
# launched without them is unaffected (claim-gate.py's own Monday-only default).
[ -n "$CLAIM_TOOL" ] && export DF_CLAIM_TOOL="$CLAIM_TOOL"
[ -n "$CLAIM_ITEM_KEYS" ] && export DF_CLAIM_ITEM_KEYS="$CLAIM_ITEM_KEYS"
# --claim-values-key "" is a real, distinct value (see the flag's own comment above), so
# this is gated on CLAIM_VALUES_KEY_SET, never on [ -n "$CLAIM_VALUES_KEY" ].
[ "$CLAIM_VALUES_KEY_SET" = "1" ] && export DF_CLAIM_VALUES_KEY="$CLAIM_VALUES_KEY"

if [ "$DRY" = "1" ]; then
  printf 'scratch: %s\n' "$SCRATCH"
  printf 'plugin-root: %s\n' "$PLUGIN_ROOT"
  if [ "$MCP_MODE" = "connector" ]; then
    printf 'mcp-mode: connector (%s)\n' "$MCP_CONNECTOR_NAME"
  else
    printf 'mcp-profile: %s\n' "$PROFILE"
  fi
  printf 'frame:%s\n' "${FRAME:- (none)}"
  printf '%s' "$RULES_LIST" | while IFS= read -r rf; do
    [ -n "$rf" ] && printf 'rules: %s\n' "$rf"
  done
  printf '%s' "$DENY_LIST" | while IFS= read -r dr; do
    [ -n "$dr" ] && printf 'deny: %s\n' "$dr"
  done
  printf '%s' "$DISALLOW_LIST" | while IFS= read -r dn; do
    [ -n "$dn" ] && printf 'disallow: %s\n' "$dn"
  done
  [ -n "$CLAIM_COLUMNS" ] && printf 'claim-columns: %s\n' "$CLAIM_COLUMNS"
  [ -n "$CLAIM_TOOL" ] && printf 'claim-tool: %s\n' "$CLAIM_TOOL"
  [ -n "$CLAIM_ITEM_KEYS" ] && printf 'claim-item-keys: %s\n' "$CLAIM_ITEM_KEYS"
  [ "$CLAIM_VALUES_KEY_SET" = "1" ] && printf 'claim-values-key: %s\n' "$CLAIM_VALUES_KEY"
  printf -- '---- env ----\n'
  printf 'DF_TICKET=%s\n' "$DF_TICKET"
  printf 'DF_ROLE=%s\n' "$DF_ROLE"
  printf 'DF_MISSION=%s\n' "$DF_MISSION"
  printf 'DF_SCRATCH=%s\n' "$DF_SCRATCH"
  printf 'DF_MCP_MODE=%s\n' "$DF_MCP_MODE"
  [ -n "$CLAIM_COLUMNS" ] && printf 'DF_CLAIM_COLUMNS=%s\n' "$DF_CLAIM_COLUMNS"
  [ -n "$CLAIM_TOOL" ] && printf 'DF_CLAIM_TOOL=%s\n' "$DF_CLAIM_TOOL"
  [ -n "$CLAIM_ITEM_KEYS" ] && printf 'DF_CLAIM_ITEM_KEYS=%s\n' "$DF_CLAIM_ITEM_KEYS"
  [ "$CLAIM_VALUES_KEY_SET" = "1" ] && printf 'DF_CLAIM_VALUES_KEY=%s\n' "$DF_CLAIM_VALUES_KEY"
  printf -- '---- argv ----\n'
  printf 'claude\n'
  for a in "$@"; do printf '%s\n' "$a"; done
  printf -- '---- prompt ----\n%s\n' "$PROMPT"
  exit 0
fi

CHILD="$SCRATCH/child.json"
( cd "$SCRATCH" && printf '%s' "$PROMPT" | claude "$@" ) > "$CHILD" 2> "$SCRATCH/child.err"
RC=$?

# ── the envelope ────────────────────────────────────────────────────────────────────────
# Loom reads THIS, not the worker's prose. A non-zero is_error or a non-empty
# permission_denials is UNVERIFIED work, never a summary to believe.
python3 - "$CHILD" "$SCRATCH/envelope.json" "$RC" <<'PY'
import json, sys
src, dst, rc = sys.argv[1], sys.argv[2], int(sys.argv[3])
env = {"exit_code": rc}
try:
    with open(src, encoding="utf-8") as fh:
        raw = fh.read()
    doc = json.loads(raw)
    if isinstance(doc, list):
        doc = doc[-1] if doc else {}
    if not isinstance(doc, dict):
        doc = {}
    for k in ("is_error", "num_turns", "total_cost_usd", "permission_denials",
              "subtype", "terminal_reason"):
        if k in doc:
            env[k] = doc[k]
except Exception as e:
    # An unreadable envelope is itself a finding: it means the child produced no JSON.
    env["envelope_error"] = "%s: %s" % (type(e).__name__, e)
    env["is_error"] = True
with open(dst, "w", encoding="utf-8") as fh:
    json.dump(env, fh, indent=2)
    fh.write("\n")
PY

cat "$CHILD"
exit "$RC"
