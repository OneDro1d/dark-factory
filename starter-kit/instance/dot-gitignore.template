# Copied to .gitignore in a generated instance.

# A generated cache with recorded provenance. The lockfile is the authority; committing
# the cache means two stores of the same thing, and two stores drift.
vendor/

# Regenerated by install.sh on every run, from the pinned engine.
boot-kit/scripts/

# Never commit a gate config: it is specific to what YOU are keeping out of a publish,
# and a shared one silently answers a question it was never asked about your repo.
landmarks.conf

# Live mission state: pid, heartbeat, per-iteration logs. The frame (MISSION.md,
# HARD-STOPS.md, MAP.md) is worth keeping; the runtime is not.
.df/missions/*/pid
.df/missions/*/state
.df/missions/*/heartbeat
.df/missions/*/iterations/
.df/missions/*/inbox/
.df/missions/*/*.log
.df/missions/*/preflight.json

__pycache__/
*.pyc
.DS_Store
