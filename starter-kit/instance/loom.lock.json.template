{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$comment": "ONE MACHINE'S INSTANCE OF THE DARK FACTORY METHOD. This file is the authority for what is installed here; install.sh is only the mechanism. Content that exists on disk but is not declared here is installed by nothing and reported by nothing -- so as far as every tool is concerned it does not exist. Placeholders are written __LIKE_THIS__ and are filled in by bootstrap.sh; anything still bearing one after a bootstrap is a value nobody supplied, and the installer says so rather than defaulting it.",

  "instance": {
    "name": "__INSTANCE_NAME__",
    "agentName": "",
    "$agentNameNote": "The agent names itself, on first run, in conversation. It ships EMPTY and is never defaulted -- a name handed down by a template is the template's name, not the agent's. Whatever it becomes, it never turns into a release name, an image tag, or a ticket fixVersion: releases are named after the APPLICATION plus a version.",
    "createdAt": "__CREATED_AT__"
  },

  "machine": {
    "$comment": "Which machine this lockfile describes. Read by df-preflight when more than one candidate lockfile exists, so that one checkout can carry several machines' instances without any of them reporting another machine's facts as local drift. Deliberately NOT keyed on hostname: an ephemeral container's hostname changes on every restart, so it would look stable and silently stop matching.",
    "platform": "__PLATFORM__",
    "home": "__HOME_DIR__"
  },

  "codeRoot": "__CODE_ROOT__",
  "$codeRootNote": "The directory your checkouts live under. df-preflight walks it to find a repo by its ORIGIN REMOTE, never by directory name -- names drift when a checkout is cloned or renamed, remotes do not.",

  "codeLayout": {
    "$comment": "lane -> directory, relative to codeRoot (or absolute if it starts with /). A lane is one grouping of repos you work in; name them however your work is actually divided. `null` means 'this lane legitimately does not exist on this machine' and is reported as ok, not as a gap. Leave the object EMPTY until you have lanes: df-preflight then reports `unknown` for the lane probe, which is the honest answer -- an empty layout is a gap in the record, not a fact about the machine."
  },

  "vendorDir": "vendor",
  "$vendorDirNote": "A GENERATED CACHE, never edited by hand and never the source of truth. lock-verify checks it in BOTH directions: every locked upstream is present, AND every present directory is locked. Without the second check an undeclared directory survives a rebuild by accident, and content with no recorded provenance is exactly what this tier exists to eliminate.",

  "upstreams": {
    "dark-factory": {
      "repo": "OneDro1d/dark-factory",
      "url": "https://github.com/OneDro1d/dark-factory.git",
      "commit": "__T1_COMMIT__",
      "$refSource": "__T1_REF_SOURCE__",
      "$refNote": "A COMMIT SHA, resolved at bootstrap time. Never a branch name: a branch moves under you between installs, and it moves most while it is under review -- which is exactly when people onboard onto it. Take an update by bumping this one line: git ls-remote https://github.com/OneDro1d/dark-factory.git refs/heads/main"
    }
  },
  "$upstreamsNote": "Add your own upstreams inside `upstreams`, one object each, same shape as dark-factory. `account` is optional and only matters when a machine holds several git identities: it names the one that can resolve THAT repo, and the wrong identity fails as a 404 that reads like 'repo does not exist' rather than as 'wrong account'. This note sits OUTSIDE the map on purpose -- the installer iterates every key of `upstreams` and would try to clone a comment.",

  "org": {
    "$comment": "OPTIONAL, and ABSENT BY DEFAULT: leave `upstream` empty and this machine installs Tier 1 directly, exactly as it did before this block existed. That is what makes it safe to add to a generator without re-minting every machine the generator already produced. Set it to the KEY of an entry in `upstreams` -- a key, never a repo, so the coordinates, the pin and the account are declared exactly once -- and install.sh runs THAT layer's own installer before this instance's declarations are layered on top. Delegating rather than re-listing is the whole point: the org layer decides what the org installs, and a lockfile carrying a second copy of that list drifts in the direction nobody watches, where a stale entry reads as a machine that was never set up rather than as a list that fell behind.",
    "upstream": "",
    "installer": "install.sh",
    "$installerNote": "The layer's entry point, resolved INSIDE the vendored layer. A value that is absolute or contains `..` is refused, never normalised -- the same rule the *Sources values follow, for the same reason. Order is precedence and is not cosmetic: the org installs first, this instance last, so a name declared in both resolves to THIS instance's copy, and rehydrate.sh says so on the line where it happens. A silent override is how tiers rot."
  },

  "install": {
    "$comment": "Skills SYMLINK (an edit in vendor/ is live in the next session). Hooks COPY, because __HOME__ inside them is substituted per machine -- so a hook edit needs a reinstall AND a new session. Each name must have a matching entry in its *Sources map AND each *Sources entry must have a name: lock-verify L7 checks both directions, because either half on its own installs nothing while still reading like a declaration. A source value is resolved under vendorDir unless it begins with `local:`, which resolves inside THIS instance; `upstream:` is the explicit spelling of the default. A value containing `..` is refused, never normalised.",
    "skills": [],
    "skillSources": {
      "$comment": "skill-name -> source. Under vendorDir by default, e.g. \"vinculum-loop\": \"dark-factory/skills/vinculum-loop\". Prefix `local:` for a skill this instance owns outright, e.g. \"my-skill\": \"local:boot-kit/skills/my-skill\". Keys beginning with $ are documentation, not entries."
    },
    "hooks": ["df-instance-start.sh"],
    "hookSources": {
      "$comment": "hook-file-name -> source. Under vendorDir by default. To ship a hook of your OWN, write it inside this instance and prefix the path with `local:` -- e.g. \"my-hook.sh\": \"local:boot-kit/hooks/my-hook.sh\". `local:` is resolved against THIS lockfile's directory, not against the installer's own location, so it still means your instance when the installer is the vendored copy.",
      "df-instance-start.sh": "dark-factory/starter-kit/instance/boot-kit/hooks/df-instance-start.sh"
    },
    "plugins": [
      {
        "name": "df-governed",
        "source": "upstream:plugins/df-governed",
        "dest": "~/.claude/skills/df-governed",
        "$note": "DECLARED BY DEFAULT since 2026-09-05: the governed runtime (dispatch, escalation, merge and handoff gates; claim gate; mission tick; df-worker). Remove this entry to opt out -- a kit without it is a kit whose doctrine is text the agent may or may not read."
      }
    ],
    "$pluginsNote": "DECLARED BY DEFAULT (operator decision 2026-09-05: a gate that ships disabled is the declared-never-invoked failure in template form). Each entry is {\"name\": \"df-governed\", \"source\": \"upstream:plugins/df-governed\", \"dest\": \"~/.claude/skills/df-governed\", \"$note\": \"personal skills-directory plugin, loads in every interactive session; headless workers get it via --plugin-dir from df-worker\"}. install.sh materialises `source` (a COPY, rsync/cp -- not a symlink, because the personal skills-directory loader only scans ~/.claude/skills/, and $LIVE may be redirected but the loader is not) into `dest`, and lock-verify L11/L12 check the copy stays byte-identical to the pin and, if the plugin ships one, that its tests/test-plugin-invariants.sh passes. ONE PIN: `source` MUST be `upstream:<path>` -- resolved against THIS lockfile's own `upstreams.dark-factory.commit`, never against a marketplace sha declared anywhere else. A marketplace pin living beside this one is the second copy of a fact this whole tier exists to prevent, and it is refused rather than accommodated: install.sh REFUSES any source that is not `upstream:`. `dest` MUST resolve under `~/.claude/skills/` -- anything else is refused, because that is the one directory Claude Code's personal skills-directory loader scans (docs: a `.claude-plugin/plugin.json` under `~/.claude/skills/<name>/` loads \"in every project\" as `<name>@skills-dir`, with no marketplace and no install step). MEASURED, not assumed (kitv2/b4): the marketplace + project `enabledPlugins` path delivers NOTHING to a headless `claude -p` run, with no error anywhere a worker could see it -- so this is the only interactive delivery path that was ever shown to work, and headless workers do not use it at all; they get the same plugin content through --plugin-dir, launched by df-worker. ⚠️ settings.json AT THE PLUGIN ROOT MUST NOT CARRY \"agent\". MEASURED (kitv2/b4, surprise S-1): an `agent` key there hijacks the MAIN THREAD of a headless run too -- `claude -p` with that plugin loaded via --plugin-dir never touches the tool it was asked to run, reports success, and exits 0. A plugin materialised by this section that ever gains that key silently turns every headless worker using it into a different agent. lock-verify L12 runs the plugin's own tests/test-plugin-invariants.sh, if it ships one, precisely so this kind of property is caught by something that runs, not by a comment someone has to remember to re-read."
  },

  "mcp": {
    "$comment": "OPTIONAL, and ABSENT BY DEFAULT. `profiles.<estate>` is a MACHINE fact: which MCP servers on THIS machine actually serve a given estate, so df-worker, df-preflight and lock-verify's L13 all read the same record instead of each guessing. When a profile has no entry here, the OLD rule applies everywhere: a server belongs to a profile when its NAME STARTS WITH the profile string. Two shapes, by `kind`: `hubs` names servers that live in ~/.claude.json's `mcpServers` (config-file hubs, e.g. `onedroid: https://<host>/hub/<id>/mcp (HTTP)` from `claude mcp list`) -- `servers` lists their names exactly as `mcpServers`/`claude mcp list` show them, and a worker gets them allow-listed via --mcp-config/--strict-mcp-config. `connector` names a claude.ai CONNECTOR (Scope: claude.ai config) -- measured: a connector appears in NO file, not even ~/.claude.json, so there is nothing to allow-list; instead a worker DENIES every other server's tools and inherits the connector as-is. `toolPrefix` (connector only) is `mcp__<sanitised-name>__`, where every non-alphanumeric character in the server name becomes `_` -- measured: a connector named \"claude.ai ESO\" exposes tools named `mcp__claude_ai_ESO__<upstream>__<tool>`. df-preflight --profile <estate> PROPOSES this block the same way it proposes scope.excludedRepos for an uncloned repo -- confirmed by the operator, never auto-applied. Example: {\"onedroid\": {\"kind\": \"hubs\", \"servers\": [\"example-hub\"]}, \"eso\": {\"kind\": \"connector\", \"servers\": [\"claude.ai Example\"], \"toolPrefix\": \"mcp__claude_ai_Example__\"}}.",
    "profiles": {}
  },

  "scope": {
    "$comment": "What this machine is deliberately NOT set up for. An entry in `excluded` makes df-preflight REFUSE that profile before it probes anything, instead of reporting its absence as drift to be repaired -- because on a machine that has excluded it, 'still missing' is the correct state and will stay correct forever.",
    "estates": [],
    "excluded": {}
  },

  "probed": {
    "$comment": "WRITTEN BY TOOLS, not by you. df-preflight --apply records here what it probed and you confirmed, and those values override the declarations above. Left empty on a fresh instance: nothing has been probed yet, and an empty record is honest where a guessed one is not."
  },

  "notRestorable": {
    "$comment": "Printed by install.sh on every run, so that a green install is never mistaken for a complete setup. The point of naming these is that the gap stays visible: a restore that quietly omits a step is worse than one that fails.",
    "git hosting login": "credentials cannot live in a lockfile, and should not want to",
    "MCP hub connection": "the boot-kit MCP template ships a working default hub, so what is left un-restorable is the TOKEN -- it is yours, it lives in the environment as ${DF_HUB_TOKEN}, and no installer can mint it for you. Sign up and create one at https://synapse.onedroid.ai, or point the template at your own hub instead; see AUTHENTICATION.md and boot-kit/mcp.template.json",
    "settings.json hook registration": "the installer places hook files, it does not edit your settings -- merge boot-kit/settings.template.json by hand, because a script that rewrites a shared settings file silently deletes another tool's configuration",
    "output style selection": "copy boot-kit/output-style.md into your harness output-styles directory and select it"
  }
}
